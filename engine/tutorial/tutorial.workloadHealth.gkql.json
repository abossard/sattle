    {"id": "probeHysteresisFold", "verb": "fold", "fold": {"by": ["key", "sourceKey", "name", "meter"], "observe": {"n": {"fn": "count", "args": [{"ref": "reading"}]}, "v": {"fn": "max", "args": [{"ref": "reading"}]}}, "policy": ["above", "below", "enterAfter", "exitAfter"], "state": {"state": {"start": {"lit": "Healthy"}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "state"}, {"fn": "iff", "args": [{"fn": "and", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Degraded"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Degraded"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Degraded"}]}, {"lit": "Healthy"}, {"lit": "Degraded"}]}, {"ref": "state"}]}]}}, "streak": {"start": {"lit": 0}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "streak"}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Degraded"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Degraded"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}, {"lit": 0}, {"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}]}, {"lit": 0}]}]}}}, "show": "state"}},
    {"id": "probeHysteresis", "verb": "summarize", "by": {"key": {"ref": "key"}, "sourceKey": {"ref": "sourceKey"}, "name": {"ref": "name"}, "meter": {"ref": "meter"}}, "aggregates": {"state": {"fn": "arg_max", "args": [{"ref": "windowStart"}, {"ref": "to"}]}}},
