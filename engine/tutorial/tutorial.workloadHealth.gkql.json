{
  "graph": "workloadHealth",
  "ontology": "tutorial",
  "description": "Roll measured service readiness, load-balancer probes and API capacity up to their own user flows.",
  "history": 120,
  "inputs": [
    {"name": "master", "ontology": "tutorial"},
    {"name": "tree", "ontology": "tutorial"},
