                  "fn": "and",
                  "args": [
                    {"fn": ">", "args": [{"ref": "endpoints"}, {"lit": 0}]},
                    {"fn": ">=", "args": [{"ref": "known"}, {"ref": "endpoints"}]}
                  ]
                },
                {"lit": 4},
                {"lit": 2}
              ]
            }
          ]
        }
      }
    },
