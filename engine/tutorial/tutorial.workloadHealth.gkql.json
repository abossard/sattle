        "sourceKey": {
          "fn": "concat",
          "args": [{"ref": "s.cluster"}, {"lit": "/"}, {"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]
        },
        "name": {"fn": "concat", "args": [{"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]},
        "endpoints": {"lit": 0},
        "ready": {"lit": 0},
        "known": {"lit": 0}
      }
    },
    {
      "id": "observedEndpoints",
      "verb": "project",
      "columns": {
        "key": {
          "fn": "concat",
          "args": [{"ref": "s.cluster"}, {"lit": "/"}, {"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]
        },
        "sourceKey": {
          "fn": "concat",
          "args": [{"ref": "s.cluster"}, {"lit": "/"}, {"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]
        },
        "name": {"fn": "concat", "args": [{"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]},
        "endpoints": {"lit": 1},
        "ready": {"lit": 0},
        "known": {"lit": 0}
      }
    },
    {
      "id": "observedReadiness",
      "verb": "project",
      "columns": {
        "key": {
          "fn": "concat",
          "args": [{"ref": "s.cluster"}, {"lit": "/"}, {"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]
        },
        "sourceKey": {
          "fn": "concat",
          "args": [{"ref": "s.cluster"}, {"lit": "/"}, {"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]
        },
        "name": {"fn": "concat", "args": [{"ref": "s.namespace"}, {"lit": "/"}, {"ref": "s.name"}]},
        "endpoints": {"lit": 0},
        "ready": {
          "fn": "iff",
          "args": [{"fn": "coalesce", "args": [{"ref": "p.ready"}, {"lit": false}]}, {"lit": 1}, {"lit": 0}]
