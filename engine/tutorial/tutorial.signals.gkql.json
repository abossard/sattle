{
  "graph": "signals",
  "ontology": "tutorial",
  "description": "Enter after two high readings and recover after three low readings.",
  "history": 120,
  "inputs": [
    {"name": "master", "ontology": "tutorial"}
  ],
  "parameters": [],
  "verbs": [
    {
      "id": "meter",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {
        "nodes": [
          {"var": "m", "label": "Meter"},
          {"var": "r", "label": "Resource"}
        ],
        "edges": [
          {"var": "measures", "label": "MeterOf", "from": "m", "to": "r"}
        ]
      }
    },
    {
      "id": "apiServerCpu",
      "verb": "where",
      "condition": {
        "fn": "==",
        "args": [
          {"ref": "m.metric"},
          {"lit": "apiserver_cpu_usage_percentage"}
        ]
      }
    },
    {
      "id": "keys",
      "verb": "extend",
      "columns": {
        "armId": {"ref": "r.armId"},
        "metric": {"ref": "m.metric"}
      }
    },
    {
      "id": "readings",
      "verb": "series",
      "graph": "master",
      "series": {"element": "m", "property": "reading", "lookback": "2h"}
    },
    {"id": "cpuStatePolicy", "verb": "extend", "columns": {"above": {"lit": 8.0}, "below": {"lit": 7.0}, "enterAfter": {"lit": 2}, "exitAfter": {"lit": 3}}},
    {"id": "cpuStateFold", "verb": "fold", "fold": {"by": ["r", "m", "armId", "metric"], "observe": {"n": {"fn": "count", "args": [{"ref": "reading"}]}, "v": {"fn": "max", "args": [{"ref": "reading"}]}}, "policy": ["above", "below", "enterAfter", "exitAfter"], "state": {"state": {"start": {"lit": "Healthy"}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "state"}, {"fn": "iff", "args": [{"fn": "and", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Healthy"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Healthy"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Healthy"}]}, {"lit": "Degraded"}, {"lit": "Healthy"}]}, {"ref": "state"}]}]}}, "streak": {"start": {"lit": 0}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "streak"}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Healthy"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "Healthy"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}, {"lit": 0}, {"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}]}, {"lit": 0}]}]}}}, "show": "state"}},
    {"id": "cpuState", "verb": "summarize", "by": {"r": {"ref": "r"}, "m": {"ref": "m"}, "armId": {"ref": "armId"}, "metric": {"ref": "metric"}}, "aggregates": {"state": {"fn": "arg_max", "args": [{"ref": "windowStart"}, {"ref": "to"}]}}},
    {
      "id": "signal",
      "verb": "nodes",
      "target": {
        "nodes": [
          {
            "var": "out",
            "label": "Signal",
            "id": {"ref": "m"},
            "props": {
              "armId": {"ref": "armId"},
              "metric": {"ref": "metric"},
              "state": {"ref": "state"}
            }
          }
        ]
      }
    }
  ],
  "wires": [
    {"from": "meter", "to": "apiServerCpu"},
    {"from": "apiServerCpu", "to": "keys"},
    {"from": "keys", "to": "readings"},
    {"from": "readings", "to": "cpuStateFold"},
    {"from": "keys", "to": "cpuStatePolicy"},
    {"from": "cpuStatePolicy", "to": "cpuStateFold", "port": "policy"},
    {"from": "cpuStateFold", "to": "cpuState"},
    {"from": "cpuState", "to": "signal"}
  ]
}
