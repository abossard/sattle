{
  "graph": "capabilityView",
  "ontology": "acme.biz",
  "description": "The business capabilities and the calls between them, lifted from the calls between the services that realize them.",
  "history": 8,
  "inputs": [
    {"name": "authored", "ontology": "acme.ops"},
    {"name": "tree", "ontology": "acme.svc"}
  ],
  "parameters": [],
  "verbs": [
    {"id": "bizCapability_1", "verb": "summarize", "by": {"capability": {"ref": "capability"}}, "aggregates": {"serviceCount": {"fn": "count"}}},
    {"id": "calls_1", "verb": "series", "graph": "tree", "series": {"element": "dependency", "lookback": "24h", "lateness": "3m", "properties": ["flows", "drops"]}},
    {"id": "calls_2", "verb": "summarize", "by": {"fromCapability": {"ref": "fromCapability"}, "toCapability": {"ref": "toCapability"}, "windowStart": {"ref": "windowStart"}}, "aggregates": {"callDrops": {"fn": "sum", "args": [{"ref": "drops"}]}, "callFlows": {"fn": "sum", "args": [{"ref": "flows"}]}}},
    {"id": "calls_3", "verb": "project", "columns": {"fromCapability": {"ref": "fromCapability"}, "toCapability": {"ref": "toCapability"}, "windowStart": {"ref": "windowStart"}, "callFlows": {"ref": "callFlows"}, "callDrops": {"ref": "callDrops"}, "callDropRatio": {"fn": "iff", "args": [{"fn": ">", "args": [{"ref": "callFlows"}, {"lit": 0}]}, {"fn": "/", "args": [{"ref": "callDrops"}, {"ref": "callFlows"}]}, {"lit": 0.0}]}}},
    {"id": "capabilities_1", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "BizCapability", "id": {"ref": "capability"}, "props": {"name": {"ref": "capability.name"}}}]}, "rule": "capabilities"},
    {"id": "capabilities_1_2", "verb": "graph-match", "graph": "authored", "pattern": {"nodes": [{"var": "capability", "label": "Capability"}], "edges": []}},
    {"id": "capabilities_2", "verb": "where", "condition": {"fn": "!=", "args": [{"fn": "coalesce", "args": [{"ref": "capability.status"}, {"lit": ""}]}, {"lit": "retired"}]}},
    {"id": "capabilities_3", "verb": "project", "columns": {"capability": {"ref": "capability"}}},
    {"id": "counts_1", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "BizCapability", "id": {"ref": "capability"}, "extend": true, "props": {"serviceCount": {"ref": "serviceCount"}}}]}, "rule": "counts"},
    {"id": "dependsOn_1Policy", "verb": "extend", "columns": {"above": {"lit": 0.05}, "below": {"lit": 0.02}, "enterAfter": {"lit": 3}, "exitAfter": {"lit": 3}}},
    {"id": "dependsOn_1Fold", "verb": "fold", "fold": {"by": ["fromCapability", "toCapability"], "observe": {"n": {"fn": "count", "args": [{"ref": "callDropRatio"}]}, "v": {"fn": "max", "args": [{"ref": "callDropRatio"}]}}, "policy": ["above", "below", "enterAfter", "exitAfter"], "state": {"state": {"start": {"lit": "ok"}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "state"}, {"fn": "iff", "args": [{"fn": "and", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"lit": "degraded"}, {"lit": "ok"}]}, {"ref": "state"}]}]}}, "streak": {"start": {"lit": 0}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "streak"}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}, {"lit": 0}, {"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}]}, {"lit": 0}]}]}}}, "show": "state"}},
    {"id": "dependsOn_1", "verb": "summarize", "by": {"fromCapability": {"ref": "fromCapability"}, "toCapability": {"ref": "toCapability"}}, "aggregates": {"state": {"fn": "arg_max", "args": [{"ref": "windowStart"}, {"ref": "to"}]}}},
    {"id": "images_1", "verb": "summarize", "by": {"service": {"ref": "service"}}, "aggregates": {"n": {"fn": "count"}}},
    {"id": "images_2", "verb": "where", "condition": {"fn": "==", "args": [{"ref": "n"}, {"lit": 1}]}},
    {"id": "images_3", "verb": "project", "columns": {"service1": {"ref": "service"}, "n": {"ref": "n"}}},
    {"id": "images_4", "verb": "join", "kind": "inner", "on": [{"left": "service", "right": "service1"}]},
    {"id": "images_5", "verb": "project", "columns": {"service": {"ref": "service"}, "capability": {"ref": "capability"}}},
    {"id": "lifted_1", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "BizCapability", "id": {"ref": "fromCapability"}}, {"var": "t", "label": "BizCapability", "id": {"ref": "toCapability"}}], "edges": [{"var": "e", "label": "DependsOn", "from": "s", "to": "t"}]}, "rule": "lifted"},
    {"id": "lifted_2", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "BizCapability", "id": {"ref": "fromCapability"}}, {"var": "t", "label": "BizCapability", "id": {"ref": "toCapability"}}], "edges": [{"var": "e", "label": "DependsOn", "from": "s", "to": "t", "props": {"callDropRatio": {"ref": "callDropRatio"}, "callDrops": {"ref": "callDrops"}, "callFlows": {"ref": "callFlows"}}, "extend": true}]}, "rule": "lifted"},
    {"id": "lifted_3", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "BizCapability", "id": {"ref": "fromCapability"}}, {"var": "t", "label": "BizCapability", "id": {"ref": "toCapability"}}], "edges": [{"var": "e", "label": "DependsOn", "from": "s", "to": "t", "props": {"callStatus": {"ref": "state"}}, "extend": true}]}, "rule": "lifted"},
    {"id": "lifted_1_2", "verb": "graph-match", "graph": "tree", "pattern": {"nodes": [{"var": "a", "label": "ServiceNode"}, {"var": "b", "label": "ServiceNode"}], "edges": [{"var": "d", "label": "DependsOn", "from": "a", "to": "b"}]}},
    {"id": "lifted_2_2", "verb": "project", "columns": {"dependency": {"ref": "d"}, "fromNode": {"ref": "a"}, "toNode": {"ref": "b"}}},
    {"id": "lifted_3_2", "verb": "project", "columns": {"fromService": {"ref": "service"}, "fromCapability": {"ref": "capability"}}},
    {"id": "lifted_4_left", "verb": "extend", "columns": {"fromNodeId": {"fn": "id", "args": [{"ref": "fromNode"}]}}},
    {"id": "lifted_4_right", "verb": "extend", "columns": {"fromServiceId": {"fn": "id", "args": [{"ref": "fromService"}]}}},
    {"id": "lifted_4", "verb": "join", "kind": "inner", "on": [{"left": "fromNodeId", "right": "fromServiceId"}]},
    {"id": "lifted_5", "verb": "project", "columns": {"toService": {"ref": "service"}, "toCapability": {"ref": "capability"}}},
    {"id": "lifted_6_left", "verb": "extend", "columns": {"toNodeId": {"fn": "id", "args": [{"ref": "toNode"}]}}},
    {"id": "lifted_6_right", "verb": "extend", "columns": {"toServiceId": {"fn": "id", "args": [{"ref": "toService"}]}}},
    {"id": "lifted_6", "verb": "join", "kind": "inner", "on": [{"left": "toNodeId", "right": "toServiceId"}]},
    {"id": "lifted_7", "verb": "where", "condition": {"fn": "!=", "args": [{"ref": "fromCapability"}, {"ref": "toCapability"}]}},
    {"id": "realized_1", "verb": "graph-match", "graph": "authored", "pattern": {"nodes": [{"var": "c", "label": "Capability"}, {"var": "s", "label": "Service"}], "edges": [{"var": "r", "label": "Realizes", "from": "s", "to": "c"}]}},
    {"id": "realized_2", "verb": "where", "condition": {"fn": "!=", "args": [{"fn": "coalesce", "args": [{"ref": "c.status"}, {"lit": ""}]}, {"lit": "retired"}]}},
    {"id": "realized_3", "verb": "project", "columns": {"service": {"ref": "s"}, "capability": {"ref": "c"}}},
    {"id": "tree_1", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "BizCapability", "id": {"ref": "capability"}}, {"var": "t", "label": "BizCapability", "id": {"ref": "parent"}}], "edges": [{"var": "e", "label": "Under", "from": "s", "to": "t"}]}, "rule": "tree"},
    {"id": "under_1", "verb": "graph-match", "graph": "authored", "pattern": {"nodes": [{"var": "c", "label": "Capability"}, {"var": "p", "label": "Capability"}], "edges": [{"var": "k", "label": "PartOf", "from": "c", "to": "p"}]}},
    {"id": "under_2", "verb": "where", "condition": {"fn": "and", "args": [{"fn": "!=", "args": [{"fn": "coalesce", "args": [{"ref": "c.status"}, {"lit": ""}]}, {"lit": "retired"}]}, {"fn": "!=", "args": [{"fn": "coalesce", "args": [{"ref": "p.status"}, {"lit": ""}]}, {"lit": "retired"}]}]}},
    {"id": "under_3", "verb": "project", "columns": {"capability": {"ref": "c"}, "parent": {"ref": "p"}}}
  ],
  "wires": [
    {"from": "realized_3", "to": "bizCapability_1"},
    {"from": "lifted_7", "to": "calls_1"},
    {"from": "calls_1", "to": "calls_2"},
    {"from": "calls_2", "to": "calls_3"},
    {"from": "capabilities_3", "to": "capabilities_1"},
    {"from": "capabilities_1_2", "to": "capabilities_2"},
    {"from": "capabilities_2", "to": "capabilities_3"},
    {"from": "bizCapability_1", "to": "counts_1"},
    {"from": "calls_3", "to": "dependsOn_1Fold"},
    {"from": "lifted_7", "to": "dependsOn_1Policy"},
    {"from": "dependsOn_1Policy", "to": "dependsOn_1Fold", "port": "policy"},
    {"from": "dependsOn_1Fold", "to": "dependsOn_1"},
    {"from": "realized_3", "to": "images_1"},
    {"from": "images_1", "to": "images_2"},
    {"from": "images_2", "to": "images_3"},
    {"from": "realized_3", "to": "images_4", "port": "left"},
    {"from": "images_3", "to": "images_4", "port": "right"},
    {"from": "images_4", "to": "images_5"},
    {"from": "lifted_7", "to": "lifted_1"},
    {"from": "calls_3", "to": "lifted_2"},
    {"from": "dependsOn_1", "to": "lifted_3"},
    {"from": "lifted_1_2", "to": "lifted_2_2"},
    {"from": "images_5", "to": "lifted_3_2"},
    {"from": "lifted_2_2", "to": "lifted_4_left"},
    {"from": "lifted_4_left", "to": "lifted_4", "port": "left"},
    {"from": "lifted_3_2", "to": "lifted_4_right"},
    {"from": "lifted_4_right", "to": "lifted_4", "port": "right"},
    {"from": "images_5", "to": "lifted_5"},
    {"from": "lifted_4", "to": "lifted_6_left"},
    {"from": "lifted_6_left", "to": "lifted_6", "port": "left"},
    {"from": "lifted_5", "to": "lifted_6_right"},
    {"from": "lifted_6_right", "to": "lifted_6", "port": "right"},
    {"from": "lifted_6", "to": "lifted_7"},
    {"from": "realized_1", "to": "realized_2"},
    {"from": "realized_2", "to": "realized_3"},
    {"from": "under_3", "to": "tree_1"},
    {"from": "under_1", "to": "under_2"},
    {"from": "under_2", "to": "under_3"}
  ],
  "rules": [
    {"name": "capabilities", "accept": ["create", "delete"], "update": ["name"], "create": {"key": "capability", "set": {"capId": {"ref": "key.id"}, "owner": {"lit": "unassigned"}, "status": {"lit": "active"}}}, "delete": {"set": {"status": {"lit": "retired"}}}},
    {"name": "counts", "description": "number of services realizing the capability"},
    {"name": "lifted", "description": "service dependencies lifted to the capabilities that realize their ends"},
    {"name": "tree", "accept": ["create", "delete"]}
  ]
}
