graph treeRollup : acme.tree with (
    description = "The roll-up policy of every element, and the edges the roll-up follows: an element whose policy is ignore does not roll up what is below it.",
    history = 4);
// How each element of the tree rolls up its children: a policy chosen by key, else by kind, else "worst",
// and the edges along which severity rolls up (none below an element whose policy is "ignore").
input structure : acme.tree;
input master : acme.ops;

let els = graph("structure") | graph-match (e) where labels(e) has "Element" project e = e.id, pk = e.nodeKey, pkind = e.nodeKind;
let policyRows = graph("master") | graph-match (u) where labels(u) has "RollupPolicy" project ptarget = u.policyTarget, pmode = u.policyMode, pshare = coalesce(u.policyShare, 0.5);
let policies = union (els | project pk, pm = "worst", ps = 0.5, rank = 0),
                     (els | join kind=inner (policyRows) on $left.pkind == $right.ptarget | project pk, pm = pmode, ps = pshare, rank = 1),
                     (els | join kind=inner (policyRows) on $left.pk == $right.ptarget | project pk, pm = pmode, ps = pshare, rank = 2)
    | summarize arg_max(rank, pm, ps) by pk
    | project pk, mode = pm, share = ps;

nodes Element on e = els | project e, nodeKey = pk, nodeKind = pkind;
extend nodes Element on el = policies | project el = identity("element", pk), rollupMode = mode, rollupShare = share;
edges Rolls from p to c = graph("structure")
    | graph-match (p)-[k]->(c) where labels(p) has "Element" and labels(k) has "Contains" and labels(c) has "Element" project p = p.id, c = c.id, parentKey = p.nodeKey
    | join kind=inner (policies) on $left.parentKey == $right.pk
    | where mode != "ignore"
    | project p, c;
