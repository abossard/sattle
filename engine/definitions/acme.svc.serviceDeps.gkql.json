{
  "graph": "serviceDeps",
  "ontology": "acme.svc",
  "description": "The service tree: the services of each namespace and who calls whom, lifted from the calls between their instances.",
  "history": 4,
  "inputs": [
    {"name": "master", "ontology": "acme.ops"}
  ],
  "parameters": [],
  "verbs": [
    {"id": "backing_1", "verb": "graph-match", "graph": "master", "pattern": {"nodes": [{"var": "p", "label": "Instance"}, {"var": "s", "label": "Service"}], "edges": [{"var": "b", "label": "Backs", "from": "p", "to": "s"}]}},
    {"id": "backing_2", "verb": "project", "columns": {"instance": {"ref": "p"}, "service": {"ref": "s"}}},
    {"id": "calls_1", "verb": "graph-match", "graph": "master", "pattern": {"nodes": [{"var": "a", "label": "Instance"}, {"var": "b", "label": "Instance"}], "edges": [{"var": "c", "label": "Calls", "from": "a", "to": "b"}]}},
    {"id": "calls_10", "verb": "project", "columns": {"call": {"ref": "call"}, "fromInstance": {"ref": "fromInstance"}, "toInstance": {"ref": "toInstance"}, "src": {"ref": "src"}, "dst": {"ref": "dst"}}},
    {"id": "calls_2", "verb": "project", "columns": {"call": {"ref": "c"}, "fromInstance": {"ref": "a"}, "toInstance": {"ref": "b"}}},
    {"id": "calls_3", "verb": "project", "columns": {"fromInstance": {"ref": "instance"}, "src": {"ref": "service"}}},
    {"id": "calls_4", "verb": "project", "columns": {"fromInstance1": {"ref": "fromInstance"}, "src": {"ref": "src"}}},
    {"id": "calls_5", "verb": "join", "kind": "inner", "on": [{"left": "fromInstance", "right": "fromInstance1"}]},
    {"id": "calls_6", "verb": "project", "columns": {"toInstance": {"ref": "instance"}, "dst": {"ref": "service"}}},
    {"id": "calls_7", "verb": "project", "columns": {"toInstance1": {"ref": "toInstance"}, "dst": {"ref": "dst"}}},
    {"id": "calls_8", "verb": "join", "kind": "inner", "on": [{"left": "toInstance", "right": "toInstance1"}]},
    {"id": "calls_9", "verb": "where", "condition": {"fn": "!=", "args": [{"ref": "src"}, {"ref": "dst"}]}},
    {"id": "dependsOn_1Policy", "verb": "extend", "columns": {"above": {"lit": 0.05}, "below": {"lit": 0.02}, "enterAfter": {"lit": 3}, "exitAfter": {"lit": 3}}},
    {"id": "dependsOn_1Fold", "verb": "fold", "fold": {"by": ["dst", "src"], "observe": {"n": {"fn": "count", "args": [{"ref": "dropRatio"}]}, "v": {"fn": "max", "args": [{"ref": "dropRatio"}]}}, "policy": ["above", "below", "enterAfter", "exitAfter"], "state": {"state": {"start": {"lit": "ok"}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "state"}, {"fn": "iff", "args": [{"fn": "and", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}]}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"lit": "degraded"}, {"lit": "ok"}]}, {"ref": "state"}]}]}}, "streak": {"start": {"lit": 0}, "next": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "n"}, {"lit": 0}]}, {"ref": "streak"}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "above"}]}, {"fn": "<=", "args": [{"fn": "coalesce", "args": [{"ref": "v"}, {"lit": 0.0}]}, {"ref": "below"}]}]}, {"fn": "iff", "args": [{"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "state"}, {"lit": "ok"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "enterAfter"}]}, {"fn": ">=", "args": [{"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}, {"ref": "exitAfter"}]}]}, {"lit": 0}, {"fn": "+", "args": [{"ref": "streak"}, {"lit": 1}]}]}, {"lit": 0}]}]}}}, "show": "state"}},
    {"id": "dependsOn_1", "verb": "summarize", "by": {"dst": {"ref": "dst"}, "src": {"ref": "src"}}, "aggregates": {"state": {"fn": "arg_max", "args": [{"ref": "windowStart"}, {"ref": "to"}]}}},
    {"id": "emit_1", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ServiceNode", "id": {"ref": "service"}, "props": {"site": {"ref": "site"}, "name": {"ref": "name"}, "namespace": {"ref": "namespace"}}}]}},
    {"id": "emit_10", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ServiceGroup", "id": {"identity": "serviceGroup", "args": [{"ref": "site"}, {"ref": "namespace"}]}, "extend": true, "props": {"flowsOut": {"ref": "flowsOut"}}}]}},
    {"id": "emit_2", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ServiceNode", "id": {"ref": "service"}, "extend": true, "props": {"instances": {"ref": "instances"}}}]}},
    {"id": "emit_3", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ServiceGroup", "id": {"identity": "serviceGroup", "args": [{"ref": "site"}, {"ref": "namespace"}]}, "props": {"site": {"ref": "site"}, "namespace": {"ref": "namespace"}}}]}},
    {"id": "emit_4", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ServiceGroup", "id": {"identity": "serviceGroup", "args": [{"ref": "site"}, {"ref": "namespace"}]}, "extend": true, "props": {"services": {"ref": "services"}}}]}},
    {"id": "emit_5", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "ServiceGroup", "id": {"identity": "serviceGroup", "args": [{"ref": "site"}, {"ref": "namespace"}]}}, {"var": "t", "label": "ServiceNode", "id": {"ref": "service"}}], "edges": [{"var": "e", "label": "Contains", "from": "s", "to": "t"}]}},
    {"id": "emit_6", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "ServiceNode", "id": {"ref": "src"}}, {"var": "t", "label": "ServiceNode", "id": {"ref": "dst"}}], "edges": [{"var": "e", "label": "DependsOn", "from": "s", "to": "t"}]}},
    {"id": "emit_7", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "ServiceNode", "id": {"ref": "src"}}, {"var": "t", "label": "ServiceNode", "id": {"ref": "dst"}}], "edges": [{"var": "e", "label": "DependsOn", "from": "s", "to": "t", "props": {"dropRatio": {"ref": "dropRatio"}, "drops": {"ref": "drops"}, "flowRate": {"fn": "rate", "args": [{"ref": "flows"}]}, "flows": {"ref": "flows"}}, "extend": true}]}},
    {"id": "emit_8", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "ServiceNode", "id": {"ref": "src"}}, {"var": "t", "label": "ServiceNode", "id": {"ref": "dst"}}], "edges": [{"var": "e", "label": "DependsOn", "from": "s", "to": "t", "props": {"status": {"ref": "state"}}, "extend": true}]}},
    {"id": "emit_9", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ServiceNode", "id": {"ref": "src"}, "extend": true, "props": {"flowsOut": {"ref": "flowsOut"}}}]}},
    {"id": "flows_1", "verb": "project", "columns": {"src": {"ref": "service"}, "site": {"ref": "site"}, "namespace": {"ref": "namespace"}}},
    {"id": "flows_2", "verb": "project", "columns": {"src1": {"ref": "src"}, "site": {"ref": "site"}, "namespace": {"ref": "namespace"}}},
    {"id": "flows_3", "verb": "join", "kind": "inner", "on": [{"left": "src", "right": "src1"}]},
    {"id": "flows_4", "verb": "series", "graph": "master", "series": {"element": "call", "lookback": "24h", "lateness": "3m", "properties": ["flows", "drops"]}},
    {"id": "flows_5", "verb": "summarize", "by": {"site": {"ref": "site"}, "dst": {"ref": "dst"}, "namespace": {"ref": "namespace"}, "src": {"ref": "src"}, "windowStart": {"ref": "windowStart"}}, "aggregates": {"drops": {"fn": "sum", "args": [{"ref": "drops"}]}, "flows": {"fn": "sum", "args": [{"ref": "flows"}]}}},
    {"id": "flows_6", "verb": "project", "columns": {"src": {"ref": "src"}, "dst": {"ref": "dst"}, "site": {"ref": "site"}, "namespace": {"ref": "namespace"}, "windowStart": {"ref": "windowStart"}, "flows": {"ref": "flows"}, "drops": {"ref": "drops"}, "dropRatio": {"fn": "iff", "args": [{"fn": ">", "args": [{"ref": "flows"}, {"lit": 0}]}, {"fn": "/", "args": [{"ref": "drops"}, {"ref": "flows"}]}, {"lit": 0.0}]}}},
    {"id": "serviceGroup_1", "verb": "summarize", "by": {"site": {"ref": "site"}, "namespace": {"ref": "namespace"}}, "aggregates": {"services": {"fn": "count"}}},
    {"id": "serviceGroup_2", "verb": "summarize", "by": {"site": {"ref": "site"}, "namespace": {"ref": "namespace"}, "windowStart": {"ref": "windowStart"}}, "aggregates": {"flowsOut": {"fn": "sum", "args": [{"ref": "flows"}]}}},
    {"id": "serviceNode_1", "verb": "summarize", "by": {"service": {"ref": "service"}}, "aggregates": {"instances": {"fn": "count"}}},
    {"id": "serviceNode_2", "verb": "summarize", "by": {"src": {"ref": "src"}, "windowStart": {"ref": "windowStart"}}, "aggregates": {"flowsOut": {"fn": "sum", "args": [{"ref": "flows"}]}}},
    {"id": "services_1", "verb": "graph-match", "graph": "master", "pattern": {"nodes": [{"var": "s", "label": "Service"}], "edges": []}},
    {"id": "services_2", "verb": "project", "columns": {"service": {"ref": "s"}, "site": {"ref": "s.site"}, "namespace": {"ref": "s.namespace"}, "name": {"ref": "s.name"}}}
  ],
  "wires": [
    {"from": "backing_1", "to": "backing_2"},
    {"from": "calls_9", "to": "calls_10"},
    {"from": "calls_1", "to": "calls_2"},
    {"from": "backing_2", "to": "calls_3"},
    {"from": "calls_3", "to": "calls_4"},
    {"from": "calls_2", "to": "calls_5", "port": "left"},
    {"from": "calls_4", "to": "calls_5", "port": "right"},
    {"from": "backing_2", "to": "calls_6"},
    {"from": "calls_6", "to": "calls_7"},
    {"from": "calls_5", "to": "calls_8", "port": "left"},
    {"from": "calls_7", "to": "calls_8", "port": "right"},
    {"from": "calls_8", "to": "calls_9"},
    {"from": "flows_6", "to": "dependsOn_1Fold"},
    {"from": "flows_3", "to": "dependsOn_1Policy"},
    {"from": "dependsOn_1Policy", "to": "dependsOn_1Fold", "port": "policy"},
    {"from": "dependsOn_1Fold", "to": "dependsOn_1"},
    {"from": "services_2", "to": "emit_1"},
    {"from": "serviceGroup_2", "to": "emit_10"},
    {"from": "serviceNode_1", "to": "emit_2"},
    {"from": "services_2", "to": "emit_3"},
    {"from": "serviceGroup_1", "to": "emit_4"},
    {"from": "services_2", "to": "emit_5"},
    {"from": "calls_10", "to": "emit_6"},
    {"from": "flows_6", "to": "emit_7"},
    {"from": "dependsOn_1", "to": "emit_8"},
    {"from": "serviceNode_2", "to": "emit_9"},
    {"from": "services_2", "to": "flows_1"},
    {"from": "flows_1", "to": "flows_2"},
    {"from": "calls_10", "to": "flows_3", "port": "left"},
    {"from": "flows_2", "to": "flows_3", "port": "right"},
    {"from": "flows_3", "to": "flows_4"},
    {"from": "flows_4", "to": "flows_5"},
    {"from": "flows_5", "to": "flows_6"},
    {"from": "services_2", "to": "serviceGroup_1"},
    {"from": "flows_6", "to": "serviceGroup_2"},
    {"from": "backing_2", "to": "serviceNode_1"},
    {"from": "flows_6", "to": "serviceNode_2"},
    {"from": "services_1", "to": "services_2"}
  ]
