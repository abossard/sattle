/// Health model of one workload (a namespace of a cluster), stacked on smaller projections: topology, signals, state, and the health view (roll-up by bounded traversal).
module acme.healthmodel @ 1.0.0;

import sattle.infra  @ 1.0.0 sha256:b3d8b3b7310f29325a480b4531efb9b4f8d04bd47bccdfdfaa8e18ff213a15a3 as infra;
import sattle.azure  @ 1.0.0 sha256:dbcb3ed609c6539bafb84d01a084cd335c5f303073c8e92bd369b1cd3c4a3ddb as azure;
import acme.ops      @ 1.0.0 sha256:5a0cdef3852bd862df3ae3ffc75d109f7793d81c63da9b4aafb1a9a30cdc16a9 as ops;
import acme.svc      @ 1.0.0 sha256:0b06522cfa6a7198b70cd4fc99f764027dff0cc9def650f5e52de86ae1b65781 as svc;
import acme.health   @ 1.0.0 sha256:1fb5ded222bbe75415e03c138b95cb28e3d4348b4db982d9f5f2f4c7e38eb5d4 as health;

/// The components of one workload and the edges between them. The workload, the cluster and the resource groups are parameters of the space binding. Services and the workload come from the service tree, the nodes the workload runs on from the master, Azure resources from Resource Graph. A node and its virtual machine share one component identity, which is the equivalence across the Kubernetes and Azure domains.
projection topology view forward output health {
  in master: graph ops;
  in tree: graph svc;
  in workloadNamespace: param Text;
  in clusterLabel: param Text;
  in aksName: param Text;
  in nodeResourceGroup: param Text;
  in hubResourceGroup: param Text;
  retain 4;

  let workloads = match tree (g: svc.ServiceGroup) |> where g.namespace == workloadNamespace;
  let services = match tree (s: svc.ServiceNode) |> where s.namespace == workloadNamespace;
  let owned = match tree (g: svc.ServiceGroup)-[:svc.Contains]->(s: svc.ServiceNode) |> where g.namespace == workloadNamespace;
  let calls = match tree (a: svc.ServiceNode)-[:svc.DependsOn]->(b: svc.ServiceNode) |> where a.namespace == workloadNamespace and b.namespace == workloadNamespace;
  let placed = match master (p: infra.Pod)-[:infra.Backs]->(s: infra.Service), (p)-[:infra.RunsOn]->(n: infra.Node) |> where s.namespace == workloadNamespace;
  let clusters = match master (r: azure.AzureResource) |> where r.type == "microsoft.containerservice/managedclusters" and r.name == aksName;
  let machines = match master (r: azure.AzureResource) |> where r.type == "microsoft.compute/virtualmachines" and coalesce(r.resourceGroup, "") == nodeResourceGroup;
  let balancers = match master (r: azure.AzureResource) |> where r.type == "microsoft.network/loadbalancers" and coalesce(r.resourceGroup, "") == nodeResourceGroup;
  let networks = match master (r: azure.AzureResource) |> where r.type == "microsoft.network/virtualnetworks" and coalesce(r.resourceGroup, "") == nodeResourceGroup;
  let hubs = match master (r: azure.AzureResource) |> where r.type == "microsoft.eventhub/namespaces" and coalesce(r.resourceGroup, "") == hubResourceGroup;

  emit entity health.Component from workloads identity health.component(id: concat("ns/", g.cluster, "/", g.namespace))
    set { key: lowerInvariant(concat("ns/", g.cluster, "/", g.namespace)), kind: "workload", name: g.namespace };
  emit entity health.Component from services identity health.component(id: concat("svc/", s.cluster, "/", s.namespace, "/", s.name))
    set { key: lowerInvariant(concat("svc/", s.cluster, "/", s.namespace, "/", s.name)), kind: "service", name: s.name };
  emit entity health.Component from placed identity health.component(id: n.resourceId)
    set { key: lowerInvariant(coalesce(n.resourceId, "")), kind: "node", name: n.name };
  emit entity health.Component from machines identity health.component(id: r.resourceId)
    set { key: lowerInvariant(r.resourceId), kind: "node", name: r.name, azureType: r.type };
  emit entity health.Component from clusters identity health.component(id: r.resourceId)
    set { key: lowerInvariant(r.resourceId), kind: "cluster", name: r.name, azureType: r.type };
  emit entity health.Component from balancers identity health.component(id: r.resourceId)
    set { key: lowerInvariant(r.resourceId), kind: "loadbalancer", name: r.name, azureType: r.type };
  emit entity health.Component from networks identity health.component(id: r.resourceId)
    set { key: lowerInvariant(r.resourceId), kind: "network", name: r.name, azureType: r.type };
  emit entity health.Component from hubs identity health.component(id: r.resourceId)
    set { key: lowerInvariant(r.resourceId), kind: "eventhub", name: r.name, azureType: r.type };

  emit relationship health.Contains from owned key contains:
    health.component(id: concat("ns/", g.cluster, "/", g.namespace)) -> health.component(id: concat("svc/", s.cluster, "/", s.namespace, "/", s.name));
  emit relationship health.DependsOn from calls key dependsOnService:
    health.component(id: concat("svc/", a.cluster, "/", a.namespace, "/", a.name)) -> health.component(id: concat("svc/", b.cluster, "/", b.namespace, "/", b.name));
  emit relationship health.DependsOn from placed key dependsOnNode:
    health.component(id: concat("svc/", s.cluster, "/", s.namespace, "/", s.name)) -> health.component(id: n.resourceId);
  emit relationship health.DependsOn from machines key dependsOnCluster:
    health.component(id: r.resourceId) -> health.component(id: r.parentId);
  emit relationship health.DependsOn from balancers key dependsOnBalancer:
    health.component(id: r.parentId) -> health.component(id: r.resourceId);
  emit relationship health.DependsOn from networks key dependsOnNetwork:
    health.component(id: r.parentId) -> health.component(id: r.resourceId);
  // authored fact: the workload's telemetry reaches the engine through this namespace
  emit relationship health.DependsOn from hubs key dependsOnHub:
    health.component(id: concat("ns/", clusterLabel, "/", workloadNamespace)) -> health.component(id: r.resourceId);

  // the roll-up edge: a is affected by b. Containment and dependency both feed it; the traversal in the health view includes the component itself (depth 0).
  emit relationship health.Affects from owned key affectsOwned:
    health.component(id: concat("ns/", g.cluster, "/", g.namespace)) -> health.component(id: concat("svc/", s.cluster, "/", s.namespace, "/", s.name));
  emit relationship health.Affects from calls key affectsService:
    health.component(id: concat("svc/", a.cluster, "/", a.namespace, "/", a.name)) -> health.component(id: concat("svc/", b.cluster, "/", b.namespace, "/", b.name));
  emit relationship health.Affects from placed key affectsNode:
    health.component(id: concat("svc/", s.cluster, "/", s.namespace, "/", s.name)) -> health.component(id: n.resourceId);
  emit relationship health.Affects from machines key affectsCluster:
    health.component(id: r.resourceId) -> health.component(id: r.parentId);
  emit relationship health.Affects from balancers key affectsBalancer:
    health.component(id: r.parentId) -> health.component(id: r.resourceId);
  emit relationship health.Affects from networks key affectsNetwork:
    health.component(id: r.parentId) -> health.component(id: r.resourceId);
  emit relationship health.Affects from hubs key affectsHub:
    health.component(id: concat("ns/", clusterLabel, "/", workloadNamespace)) -> health.component(id: r.resourceId);
}

/// The signals of the components: one Signal entity per component and signal (named by its component id), with two thresholds (degraded, unhealthy) over the closed windows of a series. Thresholds have hysteresis; a signal without data does not exist, so its component stays Unknown.
projection signals view forward output health {
  in master: graph ops;
  in tree: graph svc;
  in workloadNamespace: param Text;
  in aksName: param Text;
  in nodeResourceGroup: param Text;
  in hubResourceGroup: param Text;
  retain 4;

  // Hubble drops over flows on the traffic into a service (from the service tree)
  let drops = match tree (a: svc.ServiceNode)-[d:svc.DependsOn]->(b: svc.ServiceNode) |> where b.namespace == workloadNamespace
    |> series tree d.dropRatio within 24h
    |> rollup by { c: concat("svc/", b.cluster, "/", b.namespace, "/", b.name) } combine { v: max(dropRatio) };
  let dropsDegraded = drops |> threshold v by { c: c } above 0.01 for 2 then "on" below 0.005 for 2 then "off" initial "off" as degraded;
  let dropsUnhealthy = drops |> threshold v by { c: c } above 0.05 for 2 then "on" below 0.02 for 2 then "off" initial "off" as unhealthy;
  emit entity health.Signal from dropsDegraded identity health.signal(component: c, name: "inbound drop ratio") set { component: c, name: "inbound drop ratio", degraded: degraded };
  emit update entity health.Signal from dropsUnhealthy identity health.signal(component: c, name: "inbound drop ratio") set { unhealthy: unhealthy };
  emit update entity health.Signal from drops identity health.signal(component: c, name: "inbound drop ratio") set { value: v };

  // Kubernetes warning events on the pods of a service
  let warnings = match master (p: infra.Pod)-[:infra.Backs]->(s: infra.Service) |> where s.namespace == workloadNamespace
    |> series master p.warnings within 24h
    |> rollup by { c: concat("svc/", s.cluster, "/", s.namespace, "/", s.name) } combine { v: sum(warnings) };
  let warningsDegraded = warnings |> threshold v by { c: c } above 1 for 1 then "on" below 0 for 3 then "off" initial "off" as degraded;
  let warningsUnhealthy = warnings |> threshold v by { c: c } above 5 for 1 then "on" below 1 for 3 then "off" initial "off" as unhealthy;
  emit entity health.Signal from warningsDegraded identity health.signal(component: c, name: "warning events") set { component: c, name: "warning events", degraded: degraded };
  emit update entity health.Signal from warningsUnhealthy identity health.signal(component: c, name: "warning events") set { unhealthy: unhealthy };

  // Azure Monitor node CPU of the cluster
  let cpu = match master (r: azure.AzureResource) |> where r.type == "microsoft.containerservice/managedclusters" and r.name == aksName
    |> series master r.cpuPercent within 24h
    |> rollup by { c: r.resourceId } combine { v: max(cpuPercent) };
  let cpuDegraded = cpu |> threshold v by { c: c } above 70 for 3 then "on" below 60 for 3 then "off" initial "off" as degraded;
  let cpuUnhealthy = cpu |> threshold v by { c: c } above 90 for 3 then "on" below 80 for 3 then "off" initial "off" as unhealthy;
  emit entity health.Signal from cpuDegraded identity health.signal(component: c, name: "cpu percent") set { component: c, name: "cpu percent", degraded: degraded };
  emit update entity health.Signal from cpuUnhealthy identity health.signal(component: c, name: "cpu percent") set { unhealthy: unhealthy };
  emit update entity health.Signal from cpu identity health.signal(component: c, name: "cpu percent") set { value: v };

  // Azure Monitor node working-set memory of the cluster
  let memory = match master (r: azure.AzureResource) |> where r.type == "microsoft.containerservice/managedclusters" and r.name == aksName
    |> series master r.memoryPercent within 24h
    |> rollup by { c: r.resourceId } combine { v: max(memoryPercent) };
  let memoryDegraded = memory |> threshold v by { c: c } above 80 for 3 then "on" below 70 for 3 then "off" initial "off" as degraded;
  let memoryUnhealthy = memory |> threshold v by { c: c } above 95 for 3 then "on" below 85 for 3 then "off" initial "off" as unhealthy;
  emit entity health.Signal from memoryDegraded identity health.signal(component: c, name: "memory percent") set { component: c, name: "memory percent", degraded: degraded };
  emit update entity health.Signal from memoryUnhealthy identity health.signal(component: c, name: "memory percent") set { unhealthy: unhealthy };
  emit update entity health.Signal from memory identity health.signal(component: c, name: "memory percent") set { value: v };

  // the load balancer VIP availability, negated so that a drop is a rise (thresholds read upward)
  let vip = match master (r: azure.AzureResource) |> where r.type == "microsoft.network/loadbalancers" and coalesce(r.resourceGroup, "") == nodeResourceGroup
    |> series master r.vipAvailability within 24h
    |> select { c: r.resourceId, windowStart: windowStart, windowEnd: windowEnd, u: -vipAvailability }
    |> rollup by { c: c } combine { v: max(u) };
  let vipDegraded = vip |> threshold v by { c: c } above -99.0 for 2 then "on" below -99.5 for 2 then "off" initial "off" as degraded;
  let vipUnhealthy = vip |> threshold v by { c: c } above -90.0 for 2 then "on" below -95.0 for 2 then "off" initial "off" as unhealthy;
  emit entity health.Signal from vipDegraded identity health.signal(component: c, name: "vip unavailability") set { component: c, name: "vip unavailability", degraded: degraded };
  emit update entity health.Signal from vipUnhealthy identity health.signal(component: c, name: "vip unavailability") set { unhealthy: unhealthy };
  emit update entity health.Signal from vip identity health.signal(component: c, name: "vip unavailability") set { value: v };

  // Event Hubs server errors
  let errors = match master (r: azure.AzureResource) |> where r.type == "microsoft.eventhub/namespaces" and coalesce(r.resourceGroup, "") == hubResourceGroup
    |> series master r.serverErrors within 24h
    |> rollup by { c: r.resourceId } combine { v: max(serverErrors) };
  let errorsDegraded = errors |> threshold v by { c: c } above 1 for 1 then "on" below 0 for 3 then "off" initial "off" as degraded;
  let errorsUnhealthy = errors |> threshold v by { c: c } above 10 for 1 then "on" below 1 for 3 then "off" initial "off" as unhealthy;
  emit entity health.Signal from errorsDegraded identity health.signal(component: c, name: "server errors") set { component: c, name: "server errors", degraded: degraded };
  emit update entity health.Signal from errorsUnhealthy identity health.signal(component: c, name: "server errors") set { unhealthy: unhealthy };
  emit update entity health.Signal from errors identity health.signal(component: c, name: "server errors") set { value: v };

  // VNet flow logs: flows denied by a security rule per minute on the virtual network
  let denied = match master (r: azure.AzureResource) |> where r.type == "microsoft.network/virtualnetworks" and coalesce(r.resourceGroup, "") == nodeResourceGroup
    |> series master r.deniedFlows within 24h
    |> rollup by { c: r.resourceId } combine { v: sum(deniedFlows) };
  let deniedDegraded = denied |> threshold v by { c: c } above 10 for 2 then "on" below 5 for 2 then "off" initial "off" as degraded;
  let deniedUnhealthy = denied |> threshold v by { c: c } above 100 for 2 then "on" below 50 for 2 then "off" initial "off" as unhealthy;
  emit entity health.Signal from deniedDegraded identity health.signal(component: c, name: "denied flows") set { component: c, name: "denied flows", degraded: degraded };
  emit update entity health.Signal from deniedUnhealthy identity health.signal(component: c, name: "denied flows") set { unhealthy: unhealthy };

  // Prometheus Cilium drop rate of the node, per second
  let nodedrops = match master (n: infra.Node) |> where isPresent(n.resourceId)
    |> series master n.dropRate within 24h
    |> rollup by { c: n.resourceId } combine { v: max(dropRate) };
  let nodedropsDegraded = nodedrops |> threshold v by { c: c } above 5 for 2 then "on" below 2 for 2 then "off" initial "off" as degraded;
  let nodedropsUnhealthy = nodedrops |> threshold v by { c: c } above 50 for 2 then "on" below 20 for 2 then "off" initial "off" as unhealthy;
  emit entity health.Signal from nodedropsDegraded identity health.signal(component: c, name: "node drop rate") set { component: c, name: "node drop rate", degraded: degraded };
  emit update entity health.Signal from nodedropsUnhealthy identity health.signal(component: c, name: "node drop rate") set { unhealthy: unhealthy };
  emit update entity health.Signal from nodedrops identity health.signal(component: c, name: "node drop rate") set { value: v };
}

/// The components with their own severity: the topology and the signals (with a Measures edge to their component), and the worst severity of each component's own signals (0 healthy, 1 degraded, 2 unhealthy). A component without a signal that has data has no own severity.
projection state view forward output health {
  in topo: graph health;
  in sigs: graph health;
  retain 4;

  let comps = match topo (c: health.Component);
  let contained = match topo (a: health.Component)-[:health.Contains]->(b: health.Component);
  let depended = match topo (a: health.Component)-[:health.DependsOn]->(b: health.Component);
  let affected = match topo (a: health.Component)-[:health.Affects]->(b: health.Component);
  let signalRows = match sigs (s: health.Signal) |> select { sc: s.component, sn: s.name, sd: s.degraded, su: s.unhealthy, sk: lowerInvariant(s.component) };
  let componentKeys = match topo (c: health.Component) |> select { ck: c.key };
  let scoped = join signalRows, componentKeys on sk == ck;
  let measured = match sigs (s: health.Signal) |> where isPresent(s.degraded);
  let severities = measured
    |> select { component: s.component, sev: if(coalesce(s.unhealthy, "off") == "on", 2, if(s.degraded == "on", 1, 0)) }
    |> group by { component: component } aggregate { own: max(sev) };

  emit entity health.Component from comps identity c set { key: c.key, kind: c.kind, name: c.name, azureType: c.azureType };
  emit relationship health.Contains from contained key contains: a -> b;
  emit relationship health.DependsOn from depended key dependsOn: a -> b;
  emit relationship health.Affects from affected key affects: a -> b;
  emit update entity health.Component from severities identity health.component(id: component) set { own: own };
  // only signals of components that exist in the topology: a signal for a component outside the model's scope would leave a dangling edge
  emit entity health.Signal from scoped identity health.signal(component: sc, name: sn) set { component: sc, name: sn, degraded: sd, unhealthy: su };
  emit relationship health.Measures from scoped key measures:
    health.signal(component: sc, name: sn) -> health.component(id: sc);
}

/// The health view: components, signals and their edges, and the state of each component: the worst own severity over everything that affects it (itself included, up to sixteen edges away, by `Traverse` over Affects). Kubernetes warnings and Activity Log operations are kept as evidence. Components with nothing to roll up stay Unknown.
projection health view forward output health {
  in master: graph ops;
  in st: graph health;
  in workloadNamespace: param Text;
  retain 4;

  let comps = match st (c: health.Component);
  let reach = comps
    |> traverse st via health.Affects out depth 0 .. 16 from c as d
    |> where isPresent(d.own);
  let worst = reach |> group by { c: c } aggregate { w: max(d.own) };
  let contained = match st (a: health.Component)-[:health.Contains]->(b: health.Component);
  let depended = match st (a: health.Component)-[:health.DependsOn]->(b: health.Component);
  let signals = match st (s: health.Signal);

  // the state of a component comes from one statement: a component that nothing with a severity affects has level -1 and is Unknown
  let unrated = comps |> select { k: c.key, w: 0 - 1 };
  let worstByKey = reach |> group by { k: c.key } aggregate { w: max(d.own) };
  let rated = union unrated, worstByKey;
  let level = rated |> group by { k: k } aggregate { w: max(w) };
  emit entity health.Component from comps identity c set { key: c.key, kind: c.kind, name: c.name, azureType: c.azureType, own: c.own };
  emit entity health.Signal from signals identity s set { component: s.component, name: s.name, degraded: s.degraded, unhealthy: s.unhealthy };
  emit relationship health.Measures from signals key measures:
    health.signal(component: s.component, name: s.name) -> health.component(id: s.component);
  emit relationship health.Contains from contained key contains: a -> b;
  emit relationship health.DependsOn from depended key dependsOn: a -> b;
  emit update entity health.Component from worst identity c set { severity: w };
  emit update entity health.Component from level identity health.component(id: k)
    set { state: if(w >= 2, "Unhealthy", if(w == 1, "Degraded", if(w == 0, "Healthy", "Unknown"))) };

  // evidence elements: single Activity Log operations on the cluster and its machines, single warning events on the pods of a service
  // only operations on components that exist in the model: an operation on a cluster or machine outside its scope (another resource group) would be evidence for a component that is not there
  let componentKeys = comps |> select { ck: c.key };
  let cloudOperations = match master (ev: azure.ActivityEvent)-[:azure.Concerns]->(r: azure.AzureResource) |> where r.type == "microsoft.containerservice/managedclusters" or r.type == "microsoft.compute/virtualmachines"
    |> select { ev: ev, r: r, rk: lowerInvariant(r.resourceId) };
  let operations = join cloudOperations, componentKeys on rk == ck;
  emit entity health.Evidence from operations identity health.evidence(id: ev.eventId)
    set { eventId: ev.eventId, kind: "activity", time: ev.time, summary: ev.operation, detail: ev.status };
  emit relationship health.EvidenceFor from operations key evidenceActivity:
    health.evidence(id: ev.eventId) -> health.component(id: r.resourceId);
  let warnings = match master (w: infra.WarningEvent)-[:infra.About]->(p: infra.Pod), (p)-[:infra.Backs]->(s: infra.Service) |> where s.namespace == workloadNamespace;
  emit entity health.Evidence from warnings identity health.evidence(id: w.eventId)
    set { eventId: w.eventId, kind: "warning", time: w.time, summary: w.reason, detail: w.message };
  emit relationship health.EvidenceFor from warnings key evidenceWarning:
    health.evidence(id: w.eventId) -> health.component(id: concat("svc/", s.cluster, "/", s.namespace, "/", s.name));

  // evidence as counts: Kubernetes warning events on the pods of a service, Activity Log operations on an Azure resource
  let warned = match master (p: infra.Pod)-[:infra.Backs]->(s: infra.Service) |> where s.namespace == workloadNamespace
    |> series master p.warnings within 24h
    |> rollup by { c: concat("svc/", s.cluster, "/", s.namespace, "/", s.name) } combine { n: sum(warnings) };
  emit update entity health.Component from warned identity health.component(id: c) set { warnings: n };
  let changed = match master (r: azure.AzureResource) |> where r.type == "microsoft.containerservice/managedclusters" or r.type == "microsoft.compute/virtualmachines"
    |> series master r.changes within 24h
    |> rollup by { c: r.resourceId } combine { n: sum(changes) };
  emit update entity health.Component from changed identity health.component(id: c) set { changes: n };
}
