/// Project ontology extension, authored business entities and master ingestion.
module acme.ops @ 1.0.0;

import sattle.infra         @ 1.0.0 sha256:34a45e53639c852d432b9046b48991f90d7d0fc70b33654d167cec443cabdeec as infra;
import sattle.source.k8s    @ 1.0.0 sha256:5fc3f38bf41ae5c4a8c19d97c4b3466511848691e9206d4588c6f621646024f6 as k8s;
import sattle.source.hubble @ 1.0.0 sha256:dd668ede69fd7bc43b2c03925028479b402ba451cfc7307eac7131ae85f9a946 as hubble;
import sattle.azure          @ 1.0.0 sha256:ab18e12c31be70f641e8f97700b2d2ebf9cc8c5fe9c315fa748cbc7821966195 as azure;
import sattle.source.azure   @ 1.0.0 sha256:24e6bf16e7736afd31149cbfb868e295523ff70d90745ca607cd598093515ba5 as azsrc;
import sattle.source.prometheus @ 1.0.0 sha256:af43adc2a32148340789bc10a096ae77de47e1e81d52487263888016136fab55 as prom;

extend infra.Pod { team?: Text; }

entity Capability { capId: Text; name: Text; owner: Text; status: Text; }
relationship PartOf   (Capability) -> (Capability);
relationship Realizes (infra.Service) -> (Capability);

constraint pattern Capability.capId "^[a-z][a-z0-9-]{1,62}$";
constraint enum Capability.status in ["active", "retired"];
constraint cardinality PartOf per source 0 .. 1;
/// The image of a service in the capability level is a function: a service realizes at most one capability. A second one is a violation of this constraint (an edit that adds it is rejected); data that has one anyway is handled by the policy of the lift in acme.biz.
constraint cardinality Realizes per source 0 .. 1;
constraint acyclic PartOf;

identity capability for Capability version "1" { id: Text by exact; }

rows CapabilityRow { capId: Text; name: Text; owner: Text; status: Text; parentId?: Text; }
rows RealizesRow   { capId: Text; cluster: Text; namespace: Text; service: Text; }

/// One series of one meter of one element of the estate: Azure Monitor metrics of a resource, Prometheus metrics of a node, warning events of a pod. The health tree reads its signals from these, with the rules below, so a new meter or threshold is data.
entity Meter { meterKey: Text; meter: Text; reading?: Decimal telemetry gauge max every 60s; }
relationship MeterOf (Meter) -> (azure.AzureResource | infra.Node | infra.Pod);
identity meter for Meter version "1" { key: Text by exact; meter: Text by exact; }

/// Authored: which meter of which kind of element is a signal. `type` is the Azure resource type (lower case), `node` or `pod`, `*` for any. The thresholds have hysteresis (enterAfter and exitAfter windows); `invert` reads the meter negated (a value that is bad when it falls). severity is 1 (degraded) or 2 (unhealthy).
entity SignalRule { ruleId: Text; ruleType: Text; ruleMeter: Text; ruleAbove: Decimal; ruleEnter: Integer; ruleBelow: Decimal; ruleExit: Integer; ruleSeverity: Integer; ruleInvert: Boolean; }
/// Authored: how a node of the health tree rolls up the states below it. target is an element key or an element kind; mode is worst, share (unhealthy when more than `share` of the elements with a state below it are) or ignore.
entity RollupPolicy { policyTarget: Text; policyMode: Text; policyShare?: Decimal; }
/// Authored curation of the health tree: action group (the element named by target is a part of the workload named by value), hide, move (the parent of target is the element named by value), critical.
entity Curation { curId: Text; curAction: Text; curTarget: Text; curValue?: Text; }
identity signalRule for SignalRule version "1" { id: Text by exact; }
identity rollupPolicy for RollupPolicy version "1" { target: Text by exact; }
identity curation for Curation version "1" { id: Text by exact; }
rows SignalRuleRow { ruleId: Text; type: Text; meter: Text; above: Decimal; enterAfter: Integer; below: Decimal; exitAfter: Integer; severity: Integer; invert: Boolean; }
rows PolicyRow     { target: Text; mode: Text; share?: Decimal; }
rows CurationRow   { curId: Text; action: Text; target: Text; value?: Text; }

projection ingest ingestion output acme.ops {
  in pods: rows k8s.PodRow;
  in services: rows k8s.ServiceRow;
  in deployments: rows k8s.DeploymentRow;
  in endpoints: rows k8s.EndpointRow;
  in flows: rows hubble.FlowRow;
  in caps: rows CapabilityRow;
  in realizes: rows RealizesRow;
  in signalRules: rows SignalRuleRow;
  in policies: rows PolicyRow;
  in curations: rows CurationRow;
  in nodes: rows k8s.NodeRow;
  in events: rows k8s.EventRow;
  in resources: rows azsrc.ResourceRow;
  in metrics: rows prom.MetricRow;
  in activity: rows azsrc.ActivityRow;
  in diagActivity: rows azsrc.ActivityRow;
  in audit: rows azsrc.AuditRow;
  in resourceMetrics: rows azsrc.ResourceMetricRow;
  in flowLogs: rows azsrc.FlowLogRow;
  retain 8;

  rule observedPods readonly "observed by the Kubernetes adapter" {
    emit entity infra.Pod from pods
      identity infra.podUid(cluster: cluster, uid: uid)
      set { cluster: cluster, namespace: namespace, name: name, phase: phase, team: teamLabel, ready: ready };
    emit relationship infra.ControlledBy from pods key controlledBy:
      infra.podUid(cluster: cluster, uid: uid)
      -> infra.deploymentName(cluster: cluster, namespace: namespace, name: deployment);
    emit relationship infra.RunsOn from pods key runsOn:
      infra.podUid(cluster: cluster, uid: uid)
      -> infra.nodeName(cluster: cluster, name: nodeName);
    link infra.podUidIsPodName from pods
      left  infra.podUid(cluster: cluster, uid: uid)
      right infra.podName(cluster: cluster, namespace: namespace, name: name)
      confidence 1.0;
  }

  rule observedDeployments readonly "observed by the Kubernetes adapter" {
    emit entity infra.Deployment from deployments
      identity infra.deploymentName(cluster: cluster, namespace: namespace, name: name)
      set { cluster: cluster, namespace: namespace, name: name, replicas: replicas };
  }

  rule observedServices readonly "observed by the Kubernetes adapter" {
    emit entity infra.Service from services
      identity infra.serviceName(cluster: cluster, namespace: namespace, name: name)
      set { cluster: cluster, namespace: namespace, name: name };
    // absent podUid makes the source identity absent, so no edge is emitted
    emit relationship infra.Backs from endpoints key backs:
      infra.podUid(cluster: cluster, uid: podUid)
      -> infra.serviceName(cluster: cluster, namespace: namespace, name: service);
  }

  rule observedCalls readonly "observed by Hubble, telemetry per 60 s window" {
    let known = flows
      |> where isPresent(srcNamespace) and isPresent(srcPod) and isPresent(dstNamespace) and isPresent(dstPod);
    let windowed = known |> window on time width 60s late revise;
    let pairs = windowed
      |> group by { cluster: cluster, srcNamespace: srcNamespace, srcPod: srcPod,
                    dstNamespace: dstNamespace, dstPod: dstPod, windowStart: windowStart }
         aggregate { flows: count(), drops: sum(if(verdict == "DROPPED", 1, 0)) };
    emit relationship infra.Calls from pairs key calls:
      infra.podName(cluster: cluster, namespace: srcNamespace, name: srcPod)
      -> infra.podName(cluster: cluster, namespace: dstNamespace, name: dstPod)
      set { flows: flows, drops: drops };
  }

  rule observedNodes readonly "observed by the Kubernetes adapter" {
    emit entity infra.Node from nodes
      identity infra.nodeName(cluster: cluster, name: name)
      set { cluster: cluster, name: name, resourceId: resourceId };
  }

  rule observedEvents readonly "Kubernetes warning events on pods, telemetry per 60 s window" {
    let podEvents = events |> where kind == "Pod" and type == "Warning";
    let eventWindows = podEvents |> window on time width 60s late revise;
    let warnings = eventWindows
      |> group by { cluster: cluster, namespace: namespace, name: name, windowStart: windowStart }
         aggregate { warnings: sum(count) };
    emit update entity infra.Pod from warnings
      identity infra.podName(cluster: cluster, namespace: namespace, name: name)
      set { warnings: warnings };
  }

  rule observedResources readonly "observed by Azure Resource Graph" {
    emit entity azure.AzureResource from resources
      identity azure.azureResource(id: id)
      set { resourceId: id, name: name, type: type, location: location, resourceGroup: resourceGroup, subscriptionId: subscriptionId, parentId: parentId };
  }

  rule observedActivity readonly "Activity Log: successful operations per resource, telemetry per 60 s window" {
    let allActivity = union activity, diagActivity;
    // one row per event: the management API and the diagnostic setting deliver the same event under the same eventId, with the resource id and the operation spelled in different case
    let activityOnce = allActivity |> select { eventId: eventId, time: time, resourceId: lowerInvariant(resourceId), status: status } |> distinct;
    let succeeded = activityOnce |> where status == "Succeeded";
    let activityWindows = succeeded |> window on time width 60s late revise;
    let changes = activityWindows
      |> group by { resourceId: resourceId, windowStart: windowStart }
         aggregate { changes: count() };
    emit update entity azure.AzureResource from changes
      identity azure.azureResource(id: resourceId)
      set { changes: changes };
  }

  rule observedActivityEvents readonly "Activity Log operations as evidence, from the management API and the diagnostic setting; kept for 24 hours of logical time" {
    let allOperations = union activity, diagActivity;
    let operations = allOperations
      |> select { eventId: eventId, time: time, resourceId: lowerInvariant(resourceId), operation: lowerInvariant(operation), status: status }
      |> distinct
      |> retain on time for 24h;
    // only the management API names the caller
    let callers = allOperations |> where isPresent(caller) |> select { eventId: eventId, time: time, caller: caller } |> distinct |> retain on time for 24h;
    emit entity azure.ActivityEvent from operations
      identity azure.activityEvent(id: eventId)
      set { eventId: eventId, time: time, operation: operation, status: status };
    emit update entity azure.ActivityEvent from callers
      identity azure.activityEvent(id: eventId)
      set { caller: caller };
    emit relationship azure.Concerns from operations key concerns:
      azure.activityEvent(id: eventId) -> azure.azureResource(id: resourceId);
  }

  rule observedWarningEvents readonly "Kubernetes warning events on pods as evidence, kept for 24 hours of logical time" {
    let warningRows = events |> where kind == "Pod" and type == "Warning" |> retain on time for 24h;
    emit entity infra.WarningEvent from warningRows
      identity infra.warningEvent(id: eventId)
      set { eventId: eventId, time: time, reason: reason, message: message, count: count };
    emit relationship infra.About from warningRows key about:
      infra.warningEvent(id: eventId) -> infra.podName(cluster: cluster, namespace: namespace, name: name);
  }

  rule observedAudit readonly "AKS audit records of the admin categories as evidence, kept for 24 hours of logical time; lease renewals are noise and are left out" {
    let requests = audit |> where resource != "leases" |> retain on time for 24h;
    emit entity infra.AuditEvent from requests
      identity infra.auditEvent(id: eventId)
      set { eventId: eventId, time: time, verb: verb, resource: resource, namespace: namespace, name: name, user: user, code: code };
  }

  rule observedResourceMetrics readonly "Azure Monitor node CPU, mean per 60 s window" {
    let cpuRows = resourceMetrics |> where metric == "node_cpu_usage_percentage";
    let cpuWindows = cpuRows |> window on time width 60s late revise;
    let cpuSums = cpuWindows
      |> group by { resourceId: lowerInvariant(resourceId), windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let cpuMeans = cpuSums |> select { resourceId: resourceId, windowStart: windowStart, mean: total / n };
    emit update entity azure.AzureResource from cpuMeans
      identity azure.azureResource(id: resourceId)
      set { cpuPercent: mean };
  }

  rule observedMetrics readonly "Prometheus node forward rate, mean per 60 s window" {
    let nodeMetrics = metrics |> where metric == "cilium_forward_rate";
    let metricWindows = nodeMetrics |> window on time width 60s late revise;
    let sums = metricWindows
      |> group by { cluster: cluster, instance: instance, windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let means = sums |> select { cluster: cluster, instance: instance, windowStart: windowStart, mean: total / n };
    emit update entity infra.Node from means
      identity infra.nodeName(cluster: cluster, name: instance)
      set { forwardRate: mean };
  }

  rule observedFlowLogs readonly "VNet flow logs: denied and new flows per virtual network, telemetry per 60 s window" {
    let tuples = flowLogs |> where state == "D" or state == "B";
    let flowWindows = tuples |> window on time width 60s late revise;
    let perVnet = flowWindows
      |> group by { vnetId: lowerInvariant(vnetId), windowStart: windowStart }
         aggregate { denied: sum(if(state == "D", 1, 0)), begun: sum(if(state == "B", 1, 0)) };
    emit update entity azure.AzureResource from perVnet
      identity azure.azureResource(id: vnetId)
      set { deniedFlows: denied, newFlows: begun };
  }

  rule observedNodeDrops readonly "Prometheus node drop rate, mean per 60 s window" {
    let dropRows = metrics |> where metric == "cilium_drop_rate";
    let dropWindows = dropRows |> window on time width 60s late revise;
    let dropSums = dropWindows
      |> group by { cluster: cluster, instance: instance, windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let dropMeans = dropSums |> select { cluster: cluster, instance: instance, windowStart: windowStart, mean: total / n };
    emit update entity infra.Node from dropMeans
      identity infra.nodeName(cluster: cluster, name: instance)
      set { dropRate: mean };
  }

  rule observedMemory readonly "Azure Monitor node memory working set, mean per 60 s window" {
    let memRows = resourceMetrics |> where metric == "node_memory_working_set_percentage";
    let memWindows = memRows |> window on time width 60s late revise;
    let memSums = memWindows
      |> group by { resourceId: lowerInvariant(resourceId), windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let memMeans = memSums |> select { resourceId: resourceId, windowStart: windowStart, mean: total / n };
    emit update entity azure.AzureResource from memMeans
      identity azure.azureResource(id: resourceId)
      set { memoryPercent: mean };
  }

  rule observedAvailability readonly "Azure Monitor load balancer VIP availability, mean per 60 s window" {
    let vipRows = resourceMetrics |> where metric == "VipAvailability";
    let vipWindows = vipRows |> window on time width 60s late revise;
    let vipSums = vipWindows
      |> group by { resourceId: lowerInvariant(resourceId), windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let vipMeans = vipSums |> select { resourceId: resourceId, windowStart: windowStart, mean: total / n };
    emit update entity azure.AzureResource from vipMeans
      identity azure.azureResource(id: resourceId)
      set { vipAvailability: mean };
  }

  rule observedServerErrors readonly "Azure Monitor Event Hubs server errors, mean per 60 s window" {
    let errRows = resourceMetrics |> where metric == "ServerErrors";
    let errWindows = errRows |> window on time width 60s late revise;
    let errSums = errWindows
      |> group by { resourceId: lowerInvariant(resourceId), windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let errMeans = errSums |> select { resourceId: resourceId, windowStart: windowStart, mean: total / n };
    emit update entity azure.AzureResource from errMeans
      identity azure.azureResource(id: resourceId)
      set { serverErrors: mean };
  }

  rule authoredCapabilities bijective {
    emit entity Capability from caps
      identity capability(id: capId)
      set { capId: capId, name: name, owner: owner, status: status };
    emit relationship PartOf from caps key partOf:
      capability(id: capId) -> capability(id: parentId);
  }

  rule authoredRealizes bijective {
    emit relationship Realizes from realizes key realizes:
      infra.serviceName(cluster: cluster, namespace: namespace, name: service)
      -> capability(id: capId);
  }

  rule authoredSignalRules bijective {
    emit entity SignalRule from signalRules
      identity signalRule(id: ruleId)
      set { ruleId: ruleId, ruleType: type, ruleMeter: meter, ruleAbove: above, ruleEnter: enterAfter, ruleBelow: below, ruleExit: exitAfter, ruleSeverity: severity, ruleInvert: invert };
  }

  rule authoredPolicies bijective {
    emit entity RollupPolicy from policies
      identity rollupPolicy(target: target)
      set { policyTarget: target, policyMode: mode, policyShare: share };
  }

  rule authoredCuration bijective {
    emit entity Curation from curations
      identity curation(id: curId)
      set { curId: curId, curAction: action, curTarget: target, curValue: value };
  }

  rule observedAzureMeters readonly "every Azure Monitor metric of every resource, mean per 60 s window" {
    let azureWindows = resourceMetrics |> window on time width 60s late revise;
    let azureSums = azureWindows
      |> group by { resourceId: lowerInvariant(resourceId), metric: metric, windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let azureMeans = azureSums |> select { resourceId: resourceId, metric: metric, windowStart: windowStart, mean: total / n };
    emit entity Meter from azureMeans
      identity meter(key: resourceId, meter: metric)
      set { meterKey: resourceId, meter: metric, reading: mean };
    emit relationship MeterOf from azureMeans key meterOfResource:
      meter(key: resourceId, meter: metric) -> azure.azureResource(id: resourceId);
  }

  rule observedNodeMeters readonly "every Prometheus metric of every node, mean per 60 s window" {
    let promWindows = metrics |> window on time width 60s late revise;
    let promSums = promWindows
      |> group by { cluster: cluster, instance: instance, metric: metric, windowStart: windowStart }
         aggregate { n: count(), total: sum(value) };
    let promMeans = promSums |> select { cluster: cluster, instance: instance, metric: metric, windowStart: windowStart, mean: total / n };
    emit entity Meter from promMeans
      identity meter(key: concat("node/", cluster, "/", instance), meter: metric)
      set { meterKey: concat("node/", cluster, "/", instance), meter: metric, reading: mean };
    emit relationship MeterOf from promMeans key meterOfNode:
      meter(key: concat("node/", cluster, "/", instance), meter: metric) -> infra.nodeName(cluster: cluster, name: instance);
  }

  rule observedPodMeters readonly "Kubernetes warning events per pod, sum per 60 s window" {
    let podWarnings = events |> where kind == "Pod" and type == "Warning";
    let podWindows = podWarnings |> window on time width 60s late revise;
    let podSums = podWindows
      |> group by { cluster: cluster, namespace: namespace, name: name, windowStart: windowStart }
         aggregate { warnings: sum(count) };
    emit entity Meter from podSums
      identity meter(key: concat("pod/", cluster, "/", namespace, "/", name), meter: "warnings")
      set { meterKey: concat("pod/", cluster, "/", namespace, "/", name), meter: "warnings", reading: toDecimal(warnings) };
    emit relationship MeterOf from podSums key meterOfPod:
      meter(key: concat("pod/", cluster, "/", namespace, "/", name), meter: "warnings") -> infra.podName(cluster: cluster, namespace: namespace, name: name);
  }
}
