// The business capabilities and the calls between them, from the calls between the services that realize them.
graph capabilityView : acme.biz;

let capabilities = graph("master")
    | graph-match (c) where labels(c) has "Capability" and c.status != "retired"
      project capability = c.id, name = c.name;
let realized = graph("master")
    | graph-match (s)-[r]->(c) where labels(r) has "Realizes" and c.status != "retired"
      project service = s.id, capability = c.id;
// a service that realizes two capabilities is in neither: Realizes is declared to give each service one capability
let images = realized | join kind=inner (realized | summarize n = count() by service | where n == 1) on service | project service, capability;
// a dependency between two services is a dependency between the capabilities that realize them
let lifted = graph("tree")
    | graph-match (a)-[d]->(b) where labels(d) has "DependsOn"
      project dependency = d.id, fromNode = a.id, toNode = b.id
    | join kind=inner (images | project fromService = service, fromCapability = capability) on $left.fromNode == $right.fromService
    | join kind=inner (images | project toService = service, toCapability = capability) on $left.toNode == $right.toService
    | where fromCapability != toCapability;
let calls = lifted
    | join kind=inner (telemetry("tree", 24h) | where property in ("flows", "drops") | project dependency = id, windowStart, property, value) on dependency
    | summarize callFlows = sumif(value, property == "flows"), callDrops = sumif(value, property == "drops") by fromCapability, toCapability, windowStart
    | extend callDropRatio = iff(callFlows > 0, callDrops / callFlows, 0.0);

nodes BizCapability on capability = capabilities;
edges Under from capability to parent = graph("master")
    | graph-match (c)-[k]->(p) where labels(k) has "PartOf" and c.status != "retired" and p.status != "retired"
      project capability = c.id, parent = p.id;
extend nodes BizCapability on capability with (rule = "counts", description = "number of services realizing the capability") = realized
    | summarize serviceCount = count() by capability;
edges DependsOn from fromCapability to toCapability with (rule = "lifted", description = "service dependencies lifted to the capabilities that realize their ends") = lifted;
extend edges DependsOn from fromCapability to toCapability with (rule = "lifted") = calls;
extend edges DependsOn from fromCapability to toCapability with (rule = "lifted") = calls
    | project fromCapability, toCapability, windowStart, value = callDropRatio, above = 0.05, enterAfter = 3, below = 0.02, exitAfter = 3
    | invoke hysteresis("degraded", "ok", "ok")
    | project fromCapability, toCapability, callStatus = state;
