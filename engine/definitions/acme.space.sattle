/// Operations graph space: the master from Kubernetes, Hubble and Azure, the authored graph from authored rows, and the views on them: the service tree, the workload model, the estate tree, capabilities, deployment health and reports.
module acme.space @ 1.0.0;

import sattle.source.k8s    @ 1.0.0 sha256:5e6031686b2731a54774a35f7126f1b8bc9ea9e8c3d34669588ffb61cc46aab7 as k8s;
import sattle.source.hubble @ 1.0.0 sha256:95433584c514e135464e77fc445141fec30b87e7cd1545544e709026682cb857 as hubble;
import sattle.source.azure   @ 1.0.0 sha256:f686c1d43c19b29e66dd559f2eb6b6f5ebda554d641cac9f5ce5012c6fd15a66 as azsrc;
import sattle.source.prometheus @ 1.0.0 sha256:2a01c41a1b364e8b156d289f2afedf42ad97e508c7f1c870872d47b44b5da0d5 as prom;
import acme.ops             @ 1.0.0 sha256:e18a1ac2b793eacfd40011667e14c290576a3365385763aaf64050cb9dd66bee as ops;
import acme.svc             @ 1.0.0 sha256:b681687da315c43cfa601ad856a8bf0d55a72825fa36b26cc5a06db785860622 as svc;
import acme.workload @ 1.0.0 sha256:917fdbe0acfa3bb8141354600945b9b7bdf714f7ea36a5b1c20b8013c6c0b347 as wl;
import acme.deployhealth @ 1.0.0 sha256:39023f1fe98a10e7a902f20edb1edeeede45034066de35cf96604c13b30905f0 as dh;
import acme.report @ 1.0.0 sha256:bfb6ff16b993c57d936eeff90edb509cf00542609b6ca1de8190510fa13157e6 as rpt;
import acme.treereport @ 1.0.0 sha256:943bc719d52b9620f935c57fe1197b422efe7049fd99caffdbc981a445d0847c as trep;
import acme.treehealth @ 1.0.0 sha256:88084a51294397bc9b04e9c8cb31be7d458381eb19beb2e7a25f445e6627cc90 as th;
import acme.tree @ 1.0.0 sha256:c9697cd696ce3cb2261fbfd7bab676ba3004f2eb0086f88ed11f4f6b83d2226e as tr;
import acme.biz             @ 1.0.0 sha256:cded3393b3cfa503e0c296f610e777f9dd01f7ecf8ecc30780b4410fc18efa63 as biz;

space operations {
  source pods      adapter "record" rows k8s.PodRow;
  source accounts  adapter "record" rows k8s.ServiceAccountRow;
  source hostRefs  adapter "record" rows k8s.HostReferenceRow;
  source services  adapter "record" rows k8s.ServiceRow;
  source deployments adapter "record" rows k8s.DeploymentRow;
  source endpoints adapter "record" rows k8s.EndpointRow;
  source selections adapter "record" rows k8s.SelectsRow;
  source flows     adapter "record"        rows hubble.FlowRow;
  source nodes     adapter "record" rows k8s.NodeRow;
  source events    adapter "record" rows k8s.EventRow;
  source resources adapter "record"  rows azsrc.ResourceRow;
  source metrics   adapter "record"      rows prom.MetricRow;
  source activity  adapter "record"   rows azsrc.ActivityRow;
  source diagActivity adapter "record" rows azsrc.DiagnosticActivityRow;
  source audit     adapter "record"       rows azsrc.AuditRow;
  source resourceMetrics adapter "record"   rows azsrc.ResourceMetricRow;
  source flowLogs adapter "record" rows azsrc.FlowLogRow;
  source caps      adapter "record"      rows ops.CapabilityRow;
  source realizes  adapter "record"      rows ops.RealizesRow;
  source signalRules adapter "record"    rows ops.SignalRuleRow;
  source policies  adapter "record"      rows ops.PolicyRow;
  source curations adapter "record"      rows ops.CurationRow;

  master graph master = ops.ingest(pods: pods, services: services, accounts: accounts, hostRefs: hostRefs, deployments: deployments, endpoints: endpoints, selections: selections,
                                   flows: flows,
                                   nodes: nodes, events: events, resources: resources, metrics: metrics,
                                   activity: activity, diagActivity: diagActivity, audit: audit, resourceMetrics: resourceMetrics, flowLogs: flowLogs);
  graph authored = ops.authored(caps: caps, realizes: realizes, signalRules: signalRules, policies: policies, curations: curations);
  graph serviceTree  = svc.serviceDeps(master: master);
  graph treeStructure = tr.treeStructure(master: master, authored: authored);
  graph treeSignals = tr.treeSignals(master: master, authored: authored);
  graph treeRollup = th.treeRollup(structure: treeStructure, authored: authored);
  graph healthTree = th.healthTree(structure: treeStructure, rollup: treeRollup, signals: treeSignals, master: master, authored: authored);
  graph healthReport = trep.healthReport(health: healthTree);
  graph capabilities = biz.capabilityView(authored: authored, tree: serviceTree);
  graph deploymentHealth = dh.deploymentHealth(master: master);
  graph deploymentReport = rpt.deploymentReport(health: deploymentHealth);
  graph workloadStructure = wl.workloadStructure(master: master, workloadNamespace: "shop", aksName: "aks-synth");
  graph workload = wl.workloadHealth(master: master, authored: authored, structure: workloadStructure, workloadNamespace: "shop");
}
