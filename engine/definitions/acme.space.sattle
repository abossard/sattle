/// Operations graph space: master from Kubernetes, Hubble and authored rows; two derived views.
module acme.space @ 1.0.0;

import sattle.source.k8s    @ 1.0.0 sha256:5fc3f38bf41ae5c4a8c19d97c4b3466511848691e9206d4588c6f621646024f6 as k8s;
import sattle.source.hubble @ 1.0.0 sha256:dd668ede69fd7bc43b2c03925028479b402ba451cfc7307eac7131ae85f9a946 as hubble;
import sattle.source.azure   @ 1.0.0 sha256:24e6bf16e7736afd31149cbfb868e295523ff70d90745ca607cd598093515ba5 as azsrc;
import sattle.source.prometheus @ 1.0.0 sha256:af43adc2a32148340789bc10a096ae77de47e1e81d52487263888016136fab55 as prom;
import acme.ops             @ 1.0.0 sha256:44d70a3832be115ec461f82c8dbcd510426e23cae66299b695106cc87f27899c as ops;
import acme.svc             @ 1.0.0 sha256:6bd5c43dc46b6b6108570b4a873c731d4104355b3ddf5893d9094c76b92e6001 as svc;
import acme.healthmodel @ 1.0.0 sha256:5703b11f1e609865a7524ee6d8fa4afcc030c6be00c58dcb88e2c47039f6df59 as hm;
import acme.deployhealth @ 1.0.0 sha256:25c34a32a59786533d70b5da1b7b382f99ae7e60a4e8885de9da77035d0fc05c as dh;
import acme.report @ 1.0.0 sha256:d4338414047e6cae7136722c5c108e7d228d7a2c23b79baea375c21c96e0ad0d as rpt;
import acme.treereport @ 1.0.0 sha256:2983df8d59126750f172617abbd0ebe544b1779a29d3b4e06d86f8c869d443e0 as trep;
import acme.treehealth @ 1.0.0 sha256:e982b70b01a671cae144ae7eaaab7a1ca8ae7abab23660b308d0101580eb2706 as th;
import acme.tree @ 1.0.0 sha256:ada1c6be4ccce9e6b243aa4ee4bbc9bdf6c8687c163d0a4826c9710aae7820c5 as tr;
import acme.biz             @ 1.0.0 sha256:ef8460f28fcf01aa44f66de3f7bddb42c8da90c50d02d3ed3f2d733ce4936254 as biz;

space operations {
  source pods      adapter "kubernetes.list-watch" rows k8s.PodRow;
  source services  adapter "kubernetes.list-watch" rows k8s.ServiceRow;
  source deployments adapter "kubernetes.list-watch" rows k8s.DeploymentRow;
  source endpoints adapter "kubernetes.list-watch" rows k8s.EndpointRow;
  source flows     adapter "hubble.observe"        rows hubble.FlowRow;
  source nodes     adapter "kubernetes.list-watch" rows k8s.NodeRow;
  source events    adapter "kubernetes.list-watch" rows k8s.EventRow;
  source resources adapter "azure.resource-graph"  rows azsrc.ResourceRow;
  source metrics   adapter "prometheus.range"      rows prom.MetricRow;
  source activity  adapter "azure.activity-log"   rows azsrc.ActivityRow;
  source diagActivity adapter "azure.diagnostic-activity" rows azsrc.ActivityRow;
  source audit     adapter "azure.aks-audit"       rows azsrc.AuditRow;
  source resourceMetrics adapter "azure.metrics"   rows azsrc.ResourceMetricRow;
  source flowLogs adapter "azure.vnet-flow-log" rows azsrc.FlowLogRow;
  source caps      adapter "sattle.authoring"      rows ops.CapabilityRow;
  source realizes  adapter "sattle.authoring"      rows ops.RealizesRow;
  source signalRules adapter "sattle.authoring"    rows ops.SignalRuleRow;
  source policies  adapter "sattle.authoring"      rows ops.PolicyRow;
  source curations adapter "sattle.authoring"      rows ops.CurationRow;

  master graph master = ops.ingest(pods: pods, services: services, deployments: deployments, endpoints: endpoints,
                                   flows: flows, caps: caps, realizes: realizes, signalRules: signalRules, policies: policies, curations: curations,
                                   nodes: nodes, events: events, resources: resources, metrics: metrics,
                                   activity: activity, diagActivity: diagActivity, audit: audit, resourceMetrics: resourceMetrics, flowLogs: flowLogs);
  graph serviceTree  = svc.serviceDeps(master: master);
  graph treeStructure = tr.treeStructure(master: master);
  graph treeSignals = tr.treeSignals(master: master);
  graph treeRollup = th.treeRollup(structure: treeStructure, master: master);
  graph healthTree = th.healthTree(structure: treeStructure, rollup: treeRollup, signals: treeSignals, master: master);
  graph healthReport = trep.healthReport(health: healthTree);
  graph capabilities = biz.capabilityView(master: master, tree: serviceTree);
  graph deploymentHealth = dh.deploymentHealth(master: master);
  graph deploymentReport = rpt.deploymentReport(health: deploymentHealth);
  graph healthTopology = hm.topology(master: master, tree: serviceTree, workloadNamespace: "shop", clusterLabel: "synth", aksName: "aks-synth", nodeResourceGroup: "mc_rg-synth_aks-synth_north", hubResourceGroup: "rg-hub");
  graph healthSignals = hm.signals(master: master, tree: serviceTree, workloadNamespace: "shop", aksName: "aks-synth", nodeResourceGroup: "mc_rg-synth_aks-synth_north", hubResourceGroup: "rg-hub");
  graph healthState = hm.state(topo: healthTopology, sigs: healthSignals);
  graph health = hm.health(master: master, st: healthState, workloadNamespace: "shop");
}
