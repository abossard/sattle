/// Operations graph space: the master from Kubernetes, Hubble, Azure and authored rows, and the views on it: the service tree, the workload model, the estate tree, capabilities, deployment health and reports.
module acme.space @ 1.0.0;

import sattle.source.k8s    @ 1.0.0 sha256:0b1c5d7a5474154d69611d57dfffbf1014ac7e809a34fa7fc61a95fb1b934c2a as k8s;
import sattle.source.hubble @ 1.0.0 sha256:95433584c514e135464e77fc445141fec30b87e7cd1545544e709026682cb857 as hubble;
import sattle.source.azure   @ 1.0.0 sha256:be995c31959e6102a8ed54512c6d5a3fb7a41f5d8d0498615a519734bc159d64 as azsrc;
import sattle.source.prometheus @ 1.0.0 sha256:2a01c41a1b364e8b156d289f2afedf42ad97e508c7f1c870872d47b44b5da0d5 as prom;
import acme.ops             @ 1.0.0 sha256:8247458215d96d0c55fda5bd14140e0d0a25db4236aea2f2749a873ceda9393d as ops;
import acme.svc             @ 1.0.0 sha256:3d66da72ac7da1d1e7b1497cb29711e35deb7a168b53001caaa4f1bfc3bf2308 as svc;
import acme.workload @ 1.0.0 sha256:e3b0e1b6d4667f837a91e83a5599ec2599d26c788a53ba0153f10c9dc663313a as wl;
import acme.deployhealth @ 1.0.0 sha256:c8f8b296e0c2856c2416fe7134b6ee8fc114a6706e8f6a9d8d03f044bdecb3c6 as dh;
import acme.report @ 1.0.0 sha256:896d7d7f075d4af8b45fa2ef27567d225fd00fa56fc7f8bafef8d5f820aa4916 as rpt;
import acme.treereport @ 1.0.0 sha256:40101af1c8f11931c8c86ffcd2499b933cf3e57fdb45c1fbe90c87b7417f5071 as trep;
import acme.treehealth @ 1.0.0 sha256:58018faaf457bf51b78ef5703378a239407937ba4c38e8994e1d22514fe65b9c as th;
import acme.tree @ 1.0.0 sha256:7c000bb14826c4d771e54b43e9e4d824389a83c00c25660cb1bf1215c6e27773 as tr;
import acme.biz             @ 1.0.0 sha256:cdbbe7a855ebfbf240f2809c3689e9e10ce3dd417cede525ca4a23ccb07d2cd6 as biz;

space operations {
  source pods      adapter "kubernetes.list-watch" rows k8s.PodRow;
  source accounts  adapter "kubernetes.list-watch" rows k8s.ServiceAccountRow;
  source hostRefs  adapter "kubernetes.list-watch" rows k8s.HostReferenceRow;
  source services  adapter "kubernetes.list-watch" rows k8s.ServiceRow;
  source deployments adapter "kubernetes.list-watch" rows k8s.DeploymentRow;
  source endpoints adapter "kubernetes.list-watch" rows k8s.EndpointRow;
  source flows     adapter "hubble.observe"        rows hubble.FlowRow;
  source nodes     adapter "kubernetes.list-watch" rows k8s.NodeRow;
  source events    adapter "kubernetes.list-watch" rows k8s.EventRow;
  source resources adapter "azure.resource-graph"  rows azsrc.ResourceRow;
  source metrics   adapter "prometheus.range"      rows prom.MetricRow;
  source activity  adapter "azure.activity-log"   rows azsrc.ActivityRow;
  source diagActivity adapter "azure.diagnostic-activity" rows azsrc.ActivityRow;
  source audit     adapter "azure.aks-audit"       rows azsrc.AuditRow;
  source resourceMetrics adapter "azure.metrics"   rows azsrc.ResourceMetricRow;
  source flowLogs adapter "azure.vnet-flow-log" rows azsrc.FlowLogRow;
  source caps      adapter "sattle.authoring"      rows ops.CapabilityRow;
  source realizes  adapter "sattle.authoring"      rows ops.RealizesRow;
  source signalRules adapter "sattle.authoring"    rows ops.SignalRuleRow;
  source policies  adapter "sattle.authoring"      rows ops.PolicyRow;
  source curations adapter "sattle.authoring"      rows ops.CurationRow;

  master graph master = ops.ingest(pods: pods, services: services, accounts: accounts, hostRefs: hostRefs, deployments: deployments, endpoints: endpoints,
                                   flows: flows, caps: caps, realizes: realizes, signalRules: signalRules, policies: policies, curations: curations,
                                   nodes: nodes, events: events, resources: resources, metrics: metrics,
                                   activity: activity, diagActivity: diagActivity, audit: audit, resourceMetrics: resourceMetrics, flowLogs: flowLogs);
  graph serviceTree  = svc.serviceDeps(master: master);
  graph treeStructure = tr.treeStructure(master: master);
  graph treeSignals = tr.treeSignals(master: master);
  graph treeRollup = th.treeRollup(structure: treeStructure, master: master);
  graph healthTree = th.healthTree(structure: treeStructure, rollup: treeRollup, signals: treeSignals, master: master);
  graph healthReport = trep.healthReport(health: healthTree);
  graph capabilities = biz.capabilityView(master: master, tree: serviceTree);
  graph deploymentHealth = dh.deploymentHealth(master: master);
  graph deploymentReport = rpt.deploymentReport(health: deploymentHealth);
  graph workloadStructure = wl.workloadStructure(master: master, workloadNamespace: "shop", aksName: "aks-synth");
  graph workload = wl.workloadHealth(master: master, structure: workloadStructure, workloadNamespace: "shop");
}
