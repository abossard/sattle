// Is my workload healthy, and if not, which part is to blame?
// Each component's state is the worst severity over everything that affects it, up to sixteen edges away.
// Its own severity comes from its signals: each meter of an Azure resource or a node and the warning events of each pod,
// read against the authored rules. A meter that has not reported for five minutes is in "no data".
graph workloadHealth : acme.workload;
declare query_parameters(workloadNamespace:string);

let stateOf = (w:long) { case(w >= 3, "Unhealthy", w == 2, "Degraded", w == 1, "No data", w == 0, "Healthy", "Unknown") };
let rules = graph("master")
    | graph-match (u) where labels(u) has "SignalRule"
      project rid = u.ruleId, rtype = u.ruleType, rmeter = u.ruleMeter, above = u.ruleAbove, enterAfter = u.ruleEnter,
              below = u.ruleBelow, exitAfter = u.ruleExit, severity = u.ruleSeverity, sign = iff(u.ruleInvert, -1.0, 1.0);

// ---- signals: the meters of Azure resources and nodes, and the warning events of the pods ----
// the windows of one property of the meters, read against their rules: raw is the reading, v the reading in the rule's direction
let windowsOf = (R:(m:string, ekey:string, meter:string, rid:string, severity:long, sign:real, above:real, enterAfter:long, below:real, exitAfter:long), p:string, fill:real) {
    R | join kind=inner (telemetry_filled("master", 30m, 5m, fill) | where property == p | project m = id, windowStart, property, value, noData) on m
      | project ekey, rid, severity, meter, windowStart, raw = toreal(value), v = toreal(value) * sign, above, enterAfter, below, exitAfter, noData
};
// a rule is on after enterAfter windows at or above its threshold, off after exitAfter windows at or below it, in no data while the meter is silent
let signalsOf = (W:(ekey:string, rid:string, severity:long, meter:string, windowStart:datetime, v:real, above:real, enterAfter:long, below:real, exitAfter:long, noData:bool)) {
    W | project ekey, rid, severity, meter, windowStart, value = v, above, enterAfter, below, exitAfter, noData | invoke hysteresis("on", "off", "off", "nodata")
};
let resourceReadings = graph("master")
    | graph-match (m)-[o]->(r) where labels(m) has "Meter" and labels(o) has "MeterOf" and labels(r) has "AzureResource"
      project m = m.id, ekey = tolower(r.resourceId), etype = tolower(r.type), meter = m.meter
    | join kind=inner (rules) on $left.meter == $right.rmeter
    | where etype == rtype or rtype == "*"
    | invoke windowsOf("reading", real(null));
extend nodes ComponentSignal on sig = resourceReadings | summarize reading = max(raw) by ekey, rid, windowStart | project sig = identity("signal", ekey, rid), windowStart, reading;
let nodeReadings = graph("master")
    | graph-match (m)-[o]->(n) where labels(m) has "Meter" and labels(o) has "MeterOf" and labels(n) has "Node"
      project m = m.id, ekey = strcat("node/", n.cluster, "/", n.name), etype = "node", meter = m.meter
    | join kind=inner (rules) on $left.meter == $right.rmeter
    | where etype == rtype or rtype == "*"
    | invoke windowsOf("reading", real(null));
extend nodes ComponentSignal on sig = nodeReadings | summarize reading = max(raw) by ekey, rid, windowStart | project sig = identity("signal", ekey, rid), windowStart, reading;
let warnings = graph("master")
    | graph-match (p)-[b]->(s) where labels(p) has "Pod" and labels(b) has "Backs" and labels(s) has "Service" and s.namespace == workloadNamespace
      project m = p.id, ekey = strcat("pod/", p.cluster, "/", p.namespace, "/", p.name), meter = "warnings"
    | distinct *
    | join kind=inner (rules) on $left.meter == $right.rmeter
    | where rtype == "pod"
    | invoke windowsOf("warnings", 0.0);
extend nodes ComponentSignal on sig = warnings | summarize events = sum(raw) by ekey, rid, windowStart | project sig = identity("signal", ekey, rid), windowStart, events;

// ---- the signals of the components and their severity: 0 off, 1 no data, 2 a degrading rule on, 3 an unhealthy rule on ----
let comps = graph("structure") | graph-match (c) where labels(c) has "Component" project c = c.id, ck = c.key;
let measured = union (resourceReadings | invoke signalsOf()), (nodeReadings | invoke signalsOf()), (warnings | invoke signalsOf())
    | project sk = ekey, rid, meter, signalSeverity = severity, signalState = state, sev = iff(state == "on", severity + 1, iff(state == "nodata", 1, 0))
    | join kind=inner (comps) on $left.sk == $right.ck;
nodes ComponentSignal on sig = measured
    | project sig = identity("signal", sk, rid), componentKey = sk, rule = rid, meter, signalSeverity, signalState;
edges Measures from sig to c = measured | project sig = identity("signal", sk, rid), c;
let signalOwn = measured | summarize own = max(sev) by k = ck;

// a pod is as bad as its own signals and those of its node; a deployment by the share of its pods
let podNode = graph("structure") | graph-match (p)-[h]->(n) where labels(p) has "WorkloadPod" and labels(h) has "HostedOn" and labels(n) has "WorkloadNode" project pk = p.key, nk = n.key;
let ownByKey = union signalOwn, (podNode | join kind=inner (signalOwn) on $left.nk == $right.k | project k = pk, own)
    | summarize own = max(own) by k;
let shares = graph("structure")
    | graph-match (d)-[c]->(p) where labels(d) has "WorkloadDeployment" and labels(c) has "Contains" and labels(p) has "WorkloadPod" project dk = d.key, pk2 = p.key
    | join kind=inner (ownByKey) on $left.pk2 == $right.k
    | summarize n = count(), bad = countif(own >= 3), weak = countif(own >= 2), silent = countif(own >= 1) by dk;
let owns = union ownByKey, (shares | project k = dk, own = iff(bad * 2 >= n, 3, iff(weak * 2 >= n, 2, iff(silent * 2 >= n, 1, 0))))
    | summarize own = max(own) by k;

// ---- the roll-up: the worst own severity over the component and everything that affects it ----
let reach = graph("structure") | graph-match (c)-[a*0..16]->(d) where labels(c) has "Component" and all(a, labels(a) has "Affects") project rk = c.key, dk2 = d.key;
let levels = union (comps | project k = ck, w = 0 - 1), (reach | join kind=inner (owns) on $left.dk2 == $right.k | summarize w = max(own) by k = rk)
    | summarize w = max(w) by k;

// ---- the components of the structure, with their own severity and their state ----
let workloads = graph("structure") | graph-match (c) where labels(c) has "Workload" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, cluster = c.cluster, namespace = c.namespace;
nodes Workload on c = workloads | project c, key, ['kind'] = k2, name, cluster, namespace;
extend nodes Workload on c = workloads | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes Workload on c = workloads | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let services = graph("structure") | graph-match (c) where labels(c) has "WorkloadService" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, cluster = c.cluster, namespace = c.namespace, externalName = c.externalName;
nodes WorkloadService on c = services | project c, key, ['kind'] = k2, name, cluster, namespace, externalName;
extend nodes WorkloadService on c = services | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes WorkloadService on c = services | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let deployments = graph("structure") | graph-match (c) where labels(c) has "WorkloadDeployment" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, cluster = c.cluster, namespace = c.namespace, replicas = c.replicas;
nodes WorkloadDeployment on c = deployments | project c, key, ['kind'] = k2, name, cluster, namespace, replicas;
extend nodes WorkloadDeployment on c = deployments | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes WorkloadDeployment on c = deployments | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let pods = graph("structure") | graph-match (c) where labels(c) has "WorkloadPod" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, cluster = c.cluster, namespace = c.namespace;
nodes WorkloadPod on c = pods | project c, key, ['kind'] = k2, name, cluster, namespace;
extend nodes WorkloadPod on c = pods | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes WorkloadPod on c = pods | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let workloadNodes = graph("structure") | graph-match (c) where labels(c) has "WorkloadNode" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, cluster = c.cluster, pool = c.pool;
nodes WorkloadNode on c = workloadNodes | project c, key, ['kind'] = k2, name, cluster, pool;
extend nodes WorkloadNode on c = workloadNodes | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes WorkloadNode on c = workloadNodes | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let nodePools = graph("structure") | graph-match (c) where labels(c) has "NodePool" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, cluster = c.cluster;
nodes NodePool on c = nodePools | project c, key, ['kind'] = k2, name, cluster;
extend nodes NodePool on c = nodePools | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes NodePool on c = nodePools | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let clusters = graph("structure") | graph-match (c) where labels(c) has "Cluster" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, resourceId = c.resourceId;
nodes Cluster on c = clusters | project c, key, ['kind'] = k2, name, resourceId;
extend nodes Cluster on c = clusters | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes Cluster on c = clusters | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
let platformResources = graph("structure") | graph-match (c) where labels(c) has "PlatformResource" project c = c.id, ck = c.key, key = c.key, k2 = c.kind, name = c.name, resourceId = c.resourceId, resourceType = c.resourceType;
nodes PlatformResource on c = platformResources | project c, key, ['kind'] = k2, name, resourceId, resourceType;
extend nodes PlatformResource on c = platformResources | join kind=inner (owns) on $left.ck == $right.k | project c, own;
extend nodes PlatformResource on c = platformResources | join kind=inner (levels) on $left.ck == $right.k | project c, severity = w, state = stateOf(w);
extend nodes WorkloadDeployment on c = deployments | join kind=inner (shares) on $left.ck == $right.dk | project c, pods = n, unhealthyPods = bad;

// ---- the edges a viewer shows: the structure without the roll-up edges, and the flows of TalksTo ----
edges Contains from a to b = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "Component" and labels(e) has "Contains" and labels(b) has "Component" project a = a.id, b = b.id;
edges HostedOn from a to b with (key = "runsOn") = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "WorkloadPod" and labels(e) has "HostedOn" and labels(b) has "WorkloadNode" project a = a.id, b = b.id;
edges MemberOf from a to b = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "Component" and labels(e) has "MemberOf" and labels(b) has "Component" project a = a.id, b = b.id;
edges BackedBy from a to b = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "WorkloadService" and labels(e) has "BackedBy" and labels(b) has "PlatformResource" project a = a.id, b = b.id;
edges ConnectedThrough from a to b = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "PlatformResource" and labels(e) has "ConnectedThrough" and labels(b) has "PlatformResource" project a = a.id, b = b.id;
edges DependsOn from a to b = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "WorkloadService" and labels(e) has "DependsOn" and labels(b) has "Component" project a = a.id, b = b.id;
edges Exposes from a to b = graph("structure") | graph-match (a)-[e]->(b) where labels(a) has "PlatformResource" and labels(e) has "Exposes" and labels(b) has "WorkloadService" project a = a.id, b = b.id;
let talks = graph("structure") | graph-match (a)-[t]->(b) where labels(a) has "WorkloadService" and labels(t) has "TalksTo" and labels(b) has "Component" project a = a.id, t = t.id, b = b.id;
edges TalksTo from a to b = talks | project a, b;
extend edges TalksTo from a to b = talks
    | join kind=inner (telemetry("structure", 30m) | where property in ("flows", "drops") | project t = id, windowStart, property, value) on t
    | summarize flows = sumif(value, property == "flows"), drops = sumif(value, property == "drops") by a, b, windowStart;
let evidence = graph("structure")
    | graph-match (e)-[f]->(s) where labels(e) has "DependencyEvidence" and labels(f) has "EvidenceFor" and labels(s) has "WorkloadService"
      project e = e.id, s = s.id, sourceKey = e.sourceKey, targetKey = e.targetKey, how = e.how, detail = e.detail;
nodes DependencyEvidence on e = evidence | project e, sourceKey, targetKey, how, detail;
edges EvidenceFor from e to s = evidence | project e, s;
