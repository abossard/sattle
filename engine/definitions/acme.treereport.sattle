/// A Markdown report of the health tree: the totals per state and one row per element that is not healthy, worst first.
module acme.treereport @ 1.0.0;

import sattle.doc    @ 1.0.0 sha256:d08f49763c2dd278261b4cadfd33f9c3209421773074c005dbd00fe95466ee4f as doc;
import acme.tree     @ 1.0.0 sha256:7c000bb14826c4d771e54b43e9e4d824389a83c00c25660cb1bf1215c6e27773 as tree;

/// A report on the health tree as a document: the elements that are not healthy and why.
projection healthReport view forward output doc {
  in health: graph tree;
  retain 4;

  let elements = match health (e: tree.Element);
  let title = values { k: "title" };
  let header = values { k: "header" };
  let totals = elements
    |> group by { k: "all" } aggregate { total: count(), degraded: sum(if(coalesce(e.rolledSeverity, -1) == 1, 1, 0)), unhealthy: sum(if(coalesce(e.rolledSeverity, -1) == 2, 1, 0)), critical: sum(if(coalesce(e.critical, false) and coalesce(e.rolledSeverity, -1) >= 1, 1, 0)) };
  let affected = elements |> where coalesce(e.rolledSeverity, -1) >= 1
    |> select { k: e.nodeKey, kind: e.nodeKind, nm: coalesce(e.nodeName, e.nodeKey), st: coalesce(e.rolledState, "Unknown"), sev: coalesce(e.rolledSeverity, -1), below: coalesce(e.unhealthyCount, 0) + coalesce(e.degradedCount, 0) };

  emit entity doc.Block from title identity doc.block(rule: "title", key: k)
    set { kind: "heading", order: "0", level: 1, text: "Estate health" };
  emit entity doc.Block from totals identity doc.block(rule: "total", key: k)
    set { kind: "stat", order: "1/total", text: "Elements", n: total };
  emit entity doc.Block from totals identity doc.block(rule: "unhealthy", key: k)
    set { kind: "stat", order: "1/unhealthy", text: "Unhealthy elements", n: unhealthy };
  emit entity doc.Block from totals identity doc.block(rule: "degraded", key: k)
    set { kind: "stat", order: "1/degraded", text: "Degraded elements", n: degraded };
  emit entity doc.Block from totals identity doc.block(rule: "critical", key: k)
    set { kind: "stat", order: "1/critical", text: "Critical elements that are not healthy", n: critical };
  emit entity doc.Block from header identity doc.block(rule: "header", key: k)
    set { kind: "header", order: "2", a: "Kind", b: "Element", c: "State", d: "Monitored below that are not healthy" };
  emit entity doc.Block from affected identity doc.block(rule: "row", key: k)
    set { kind: "row", order: concat("3/", if(sev == 2, "0", "1"), "/", k), a: kind, b: nm, c: st, n: below };
}
