    {"name": "ServiceGroup", "properties": [{"name": "site", "type": "Text"}, {"name": "namespace", "type": "Text", "label": true}, {"name": "services", "type": "Integer", "optional": true}, {"name": "flowsOut", "type": "Integer", "optional": true, "events": {"temporality": "delta", "combine": "sum", "period": "1m"}}]}
