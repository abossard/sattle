graph ingest : acme.ops with (
    description = "The master graph: what the sources observed. Pods, services, deployments and nodes of the clusters, the Azure resources, calls between pods, meters, warning, activity and audit events, and the authored capabilities, rules and policies.",
    history = 8);
// The inputs are tables of rows, one per source; a window of telemetry is 60 seconds of the rows' own time.
input pods : k8s.PodRow;
input services : k8s.ServiceRow;
input accounts : k8s.ServiceAccountRow;
input hostRefs : k8s.HostReferenceRow;
input deployments : k8s.DeploymentRow;
input endpoints : k8s.EndpointRow;
input flows : hubble.FlowRow;
input caps : CapabilityRow;
input realizes : RealizesRow;
input signalRules : SignalRuleRow;
input policies : PolicyRow;
input curations : CurationRow;
input nodes : k8s.NodeRow;
input events : k8s.EventRow;
input resources : azsrc.ResourceRow;
input metrics : prom.MetricRow;
input activity : azsrc.ActivityRow;
input diagActivity : azsrc.ActivityRow;
input audit : azsrc.AuditRow;
input resourceMetrics : azsrc.ResourceMetricRow;
input flowLogs : azsrc.FlowLogRow;

// ---- observed by the Kubernetes adapter ----
nodes Pod on pod with (rule = "observedPods", description = "observed by the Kubernetes adapter") = pods | project pod = identity("podUid", cluster, uid), cluster, namespace, name, phase, team = teamLabel, ready, serviceAccount;
edges RunsAs from pod to account with (rule = "observedPods") = pods | project pod = identity("podUid", cluster, uid), account = identity("serviceAccountName", cluster, namespace, serviceAccount);
edges ControlledBy from pod to owner with (rule = "observedPods") = pods | project pod = identity("podUid", cluster, uid), owner = identity("deploymentName", cluster, namespace, deployment);
edges RunsOn from pod to host with (rule = "observedPods") = pods | project pod = identity("podUid", cluster, uid), host = identity("nodeName", cluster, nodeName);
// a pod's uid and its name are two keys of the same pod
link podUidIsPodName from byUid to byName with (confidence = 1.0, rule = "observedPods") = pods
    | project byUid = identity("podUid", cluster, uid), byName = identity("podName", cluster, namespace, name);
nodes Deployment on d with (rule = "observedDeployments", description = "observed by the Kubernetes adapter") = deployments | project d = identity("deploymentName", cluster, namespace, name), cluster, namespace, name, replicas;
nodes HostReference on h with (rule = "observedDeployments") = hostRefs | project h = identity("hostReference", cluster, namespace, deployment, variable), cluster, namespace, deployment, variable, host;
edges Configures from h to d with (rule = "observedDeployments") = hostRefs
    | project h = identity("hostReference", cluster, namespace, deployment, variable), d = identity("deploymentName", cluster, namespace, deployment);
nodes ServiceAccount on a with (rule = "observedServiceAccounts", description = "observed by the Kubernetes adapter") = accounts | project a = identity("serviceAccountName", cluster, namespace, name), cluster, namespace, name, clientId;
nodes Service on s with (rule = "observedServices", description = "observed by the Kubernetes adapter") = services | project s = identity("serviceName", cluster, namespace, name), cluster, namespace, name, externalName, address;
edges Backs from pod to s with (rule = "observedServices") = endpoints | project pod = identity("podUid", cluster, podUid), s = identity("serviceName", cluster, namespace, service);
nodes Node on n with (rule = "observedNodes", description = "observed by the Kubernetes adapter") = nodes | project n = identity("nodeName", cluster, name), cluster, name, resourceId, pool;

// ---- observed by Hubble: calls between pods, and flows to addresses that are no pod ----
edges Calls from src to dst with (rule = "observedCalls", description = "observed by Hubble, telemetry per 60 s window") = flows
    | where isnotempty(srcNamespace) and isnotempty(srcPod) and isnotempty(dstNamespace) and isnotempty(dstPod)
    | summarize flows = count(), drops = countif(verdict == "DROPPED") by cluster, srcNamespace, srcPod, dstNamespace, dstPod, windowStart = bin(['time'], 60s)
    | project src = identity("podName", cluster, srcNamespace, srcPod), dst = identity("podName", cluster, dstNamespace, dstPod), windowStart, flows, drops;
let sent = flows
    | where isnotempty(srcNamespace) and isnotempty(srcPod) and isempty(dstPod) and isnotempty(dstAddress)
    | summarize flows = count(), drops = countif(verdict == "DROPPED"), arg_max(['time'], dstName) by cluster, srcNamespace, srcPod, address = coalesce(dstAddress, ""), windowStart = bin(['time'], 60s);
nodes Destination on dest with (rule = "observedDestinations", description = "observed by Hubble: flows of a pod to an address that is no pod, telemetry per 60 s window") = sent | project dest = identity("destination", cluster, address), windowStart, cluster, address, hostName = dstName;
edges Sends from src to dest with (rule = "observedDestinations") = sent | project src = identity("podName", cluster, srcNamespace, srcPod), dest = identity("destination", cluster, address), windowStart, flows, drops;

// ---- Kubernetes warning events on pods: a count per window, a meter of the pod, and evidence kept for 24 hours ----
let podWarnings = events | where ['kind'] == "Pod" and ['type'] == "Warning" | summarize warnings = sum(['count']) by cluster, namespace, name, windowStart = bin(['time'], 60s);
extend nodes Pod on pod with (rule = "observedEvents", description = "Kubernetes warning events on pods, telemetry per 60 s window") = podWarnings | project pod = identity("podName", cluster, namespace, name), windowStart, warnings;
let warningRows = events | where ['kind'] == "Pod" and ['type'] == "Warning" | where ['time'] > ago(24h);
nodes WarningEvent on w with (rule = "observedWarningEvents", description = "Kubernetes warning events on pods as evidence, kept for 24 hours of logical time") = warningRows | project w = identity("warningEvent", eventId), eventId, ['time'], reason, message, ['count'];
edges About from w to pod with (rule = "observedWarningEvents") = warningRows | project w = identity("warningEvent", eventId), pod = identity("podName", cluster, namespace, name);

// ---- observed by Azure Resource Graph, the Activity Log and the AKS audit log ----
nodes AzureResource on r with (rule = "observedResources", description = "observed by Azure Resource Graph") = resources
    | project r = identity("azureResource", id), resourceId = id, name, ['type'], location, resourceGroup, subscriptionId, parentId, address, linkedId, clientId, principalId, scope;
let allOperations = union activity, diagActivity;
extend nodes AzureResource on r with (rule = "observedActivity", description = "Activity Log: successful operations per resource, telemetry per 60 s window") = allOperations
    | project eventId, ['time'], resourceId = tolower(resourceId), status | distinct * | where status == "Succeeded"
    | summarize changes = count() by resourceId, windowStart = bin(['time'], 60s)
    | project r = identity("azureResource", resourceId), windowStart, changes;
let operations = allOperations | project eventId, ['time'], resourceId = tolower(resourceId), operation = tolower(operation), status | distinct * | where ['time'] > ago(24h);
nodes ActivityEvent on e with (rule = "observedActivityEvents", description = "Activity Log operations as evidence, from the management API and the diagnostic setting; kept for 24 hours of logical time") = operations | project e = identity("activityEvent", eventId), eventId, ['time'], operation, status;
extend nodes ActivityEvent on e with (rule = "observedActivityEvents") = allOperations | where isnotempty(caller) | project eventId, ['time'], caller | distinct * | where ['time'] > ago(24h)
    | project e = identity("activityEvent", eventId), caller;
edges Concerns from e to r with (rule = "observedActivityEvents") = operations | project e = identity("activityEvent", eventId), r = identity("azureResource", resourceId);
// lease renewals are noise and are left out
nodes AuditEvent on a with (rule = "observedAudit", description = "AKS audit records of the admin categories as evidence, kept for 24 hours of logical time; lease renewals are noise and are left out") = audit | where resource != "leases" | where ['time'] > ago(24h)
    | project a = identity("auditEvent", eventId), eventId, ['time'], verb, resource, namespace, name, user, code;

// ---- metrics: Azure Monitor per resource, Prometheus per node, VNet flow logs per network; per window ----
// the mean of each series per window, by resource and metric
let azureMeans = resourceMetrics
    | summarize n = count(), total = sum(value) by resourceId = tolower(resourceId), metric, windowStart = bin(['time'], 60s)
    | project resourceId, metric, windowStart, mean = total / n;
extend nodes AzureResource on r with (rule = "observedResourceMetrics", description = "Azure Monitor node CPU, mean per 60 s window") = azureMeans | where metric == "node_cpu_usage_percentage" | project r = identity("azureResource", resourceId), windowStart, cpuPercent = mean;
extend nodes AzureResource on r with (rule = "observedMemory", description = "Azure Monitor node memory working set, mean per 60 s window") = azureMeans | where metric == "node_memory_working_set_percentage" | project r = identity("azureResource", resourceId), windowStart, memoryPercent = mean;
extend nodes AzureResource on r with (rule = "observedAvailability", description = "Azure Monitor load balancer VIP availability, mean per 60 s window") = azureMeans | where metric == "VipAvailability" | project r = identity("azureResource", resourceId), windowStart, vipAvailability = mean;
extend nodes AzureResource on r with (rule = "observedServerErrors", description = "Azure Monitor Event Hubs server errors, mean per 60 s window") = azureMeans | where metric == "ServerErrors" | project r = identity("azureResource", resourceId), windowStart, serverErrors = mean;
// the node agents' metrics, whose instance is the node: per window the mean of each series, added over the series of the node
let nodeMeans = metrics
    | where isnotempty(instance) and (metric == "cilium_endpoint_state" or metric == "cilium_forward_rate" or metric == "cilium_drop_rate" or metric == "hubble_flows_rate")
    | summarize n = count(), total = sum(value) by cluster, instance = coalesce(instance, ""), metric, series, windowStart = bin(['time'], 60s)
    | project cluster, instance, metric, series, windowStart, mean = total / n
    | summarize mean = sum(mean) by cluster, instance, metric, windowStart;
extend nodes Node on n with (rule = "observedMetrics", description = "Prometheus node forward rate: per 60 s window the mean of each series, added over the series of the node") = nodeMeans | where metric == "cilium_forward_rate" | project n = identity("nodeName", cluster, instance), windowStart, forwardRate = mean;
extend nodes Node on n with (rule = "observedNodeDrops", description = "Prometheus node drop rate: per 60 s window the mean of each series, added over the series of the node") = nodeMeans | where metric == "cilium_drop_rate" | project n = identity("nodeName", cluster, instance), windowStart, dropRate = mean;
extend nodes AzureResource on r with (rule = "observedFlowLogs", description = "VNet flow logs: denied and new flows per virtual network, telemetry per 60 s window") = flowLogs | where state == "D" or state == "B"
    | summarize denied = countif(state == "D"), begun = countif(state == "B") by vnetId = tolower(vnetId), windowStart = bin(['time'], 60s)
    | project r = identity("azureResource", vnetId), windowStart, deniedFlows = denied, newFlows = begun;

// ---- meters: every series a signal rule may read ----
nodes Meter on m with (rule = "observedAzureMeters", description = "every Azure Monitor metric of every resource, mean per 60 s window") = azureMeans | project m = identity("meter", resourceId, metric), windowStart, meterKey = resourceId, meter = metric, reading = mean;
edges MeterOf from m to r with (key = "meterOfResource", rule = "observedAzureMeters") = azureMeans | project m = identity("meter", resourceId, metric), windowStart, r = identity("azureResource", resourceId);
nodes Meter on m with (rule = "observedNodeMeters", description = "the Prometheus metrics of the node agents, whose `instance` is the node: per 60 s window the mean of each series, added over the series of the node. The `instance` of another exporter's series is that exporter and no node.") = nodeMeans | project m = identity("meter", strcat("node/", cluster, "/", instance), metric), windowStart, meterKey = strcat("node/", cluster, "/", instance), meter = metric, reading = mean;
edges MeterOf from m to n with (key = "meterOfNode", rule = "observedNodeMeters") = nodeMeans | project m = identity("meter", strcat("node/", cluster, "/", instance), metric), windowStart, n = identity("nodeName", cluster, instance);
nodes Meter on m with (rule = "observedPodMeters", description = "Kubernetes warning events per pod, sum per 60 s window") = podWarnings
    | project m = identity("meter", strcat("pod/", cluster, "/", namespace, "/", name), "warnings"), windowStart, meterKey = strcat("pod/", cluster, "/", namespace, "/", name), meter = "warnings", reading = toreal(warnings);
edges MeterOf from m to pod with (key = "meterOfPod", rule = "observedPodMeters") = podWarnings
    | project m = identity("meter", strcat("pod/", cluster, "/", namespace, "/", name), "warnings"), windowStart, pod = identity("podName", cluster, namespace, name);

// ---- authored: capabilities, signal rules, roll-up policies and curations (editable in a later stage) ----
nodes Capability on c with (rule = "authoredCapabilities", accept = "create, delete", update = "capId, name, owner, status") = caps | project c = identity("capability", capId), capId, name, owner, status;
edges PartOf from c to p with (rule = "authoredCapabilities") = caps | project c = identity("capability", capId), p = identity("capability", parentId);
edges Realizes from s to c with (rule = "authoredRealizes", accept = "create, delete") = realizes | project s = identity("serviceName", cluster, namespace, service), c = identity("capability", capId);
nodes SignalRule on u with (rule = "authoredSignalRules", accept = "create, delete", update = "ruleId, ruleType, ruleMeter, ruleAbove, ruleEnter, ruleBelow, ruleExit, ruleSeverity, ruleInvert") = signalRules
    | project u = identity("signalRule", ruleId), ruleId, ruleType = ['type'], ruleMeter = meter, ruleAbove = above, ruleEnter = enterAfter, ruleBelow = below, ruleExit = exitAfter, ruleSeverity = severity, ruleInvert = invert;
nodes RollupPolicy on u with (rule = "authoredPolicies", accept = "create, delete", update = "policyTarget, policyMode, policyShare") = policies | project u = identity("rollupPolicy", target), policyTarget = target, policyMode = mode, policyShare = share;
nodes Curation on u with (rule = "authoredCuration", accept = "create, delete", update = "curId, curAction, curTarget, curValue") = curations | project u = identity("curation", curId), curId, curAction = action, curTarget = target, curValue = value;
