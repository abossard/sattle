/// Worked example of a document projection: a Markdown report of Deployment health, a table with one keyed row per Deployment and a summary, produced from the graph of acme.deployhealth.
module acme.report @ 1.0.0;

import sattle.doc        @ 1.0.0 sha256:d08f49763c2dd278261b4cadfd33f9c3209421773074c005dbd00fe95466ee4f as doc;
import acme.deployhealth @ 1.0.0 sha256:25c34a32a59786533d70b5da1b7b382f99ae7e60a4e8885de9da77035d0fc05c as dh;

projection deploymentReport view forward output doc {
  in health: graph dh;
  retain 4;

  let workloads = match health (w: dh.Workload);
  let title = values { k: "title" };
  let header = values { k: "header" };
  let totals = workloads
    |> group by { k: "all" } aggregate { total: count(), unhealthy: sum(if(coalesce(w.state, "Unknown") == "Unhealthy", 1, 0)) };
  let rows = workloads |> select { k: concat(w.cluster, "/", w.namespace, "/", w.name), ns: w.namespace, nm: w.name, st: coalesce(w.state, "Unknown"), ready: w.readyPods };

  emit entity doc.Block from title identity doc.block(rule: "title", key: k)
    set { kind: "heading", order: "0", level: 1, text: "Deployment health" };
  emit entity doc.Block from totals identity doc.block(rule: "total", key: k)
    set { kind: "stat", order: "1/total", text: "Deployments", n: total };
  emit entity doc.Block from totals identity doc.block(rule: "unhealthy", key: k)
    set { kind: "stat", order: "1/unhealthy", text: "Unhealthy deployments", n: unhealthy };
  emit entity doc.Block from header identity doc.block(rule: "header", key: k)
    set { kind: "header", order: "2", a: "Namespace", b: "Deployment", c: "State", d: "Ready pods" };
  emit entity doc.Block from rows identity doc.block(rule: "row", key: k)
    set { kind: "row", order: concat("3/", k), a: ns, b: nm, c: st, n: ready };
}
