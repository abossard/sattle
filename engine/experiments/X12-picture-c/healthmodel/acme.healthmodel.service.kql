graph service : acme.healthmodel with (
    description = "The authored health model in the form the service stores it: impact on the child entity, one relationship per link, and a proxy where the links of one child ask for different impacts.",
    history = 4);
input model : acme.healthmodel;

// impact as a number: Standard 0, Limited 1, Suppressed 2
let links = graph("model")
    | graph-match (p)-[h]->(c) where labels(h) has "HasChild"
      project pk = p.key, ck = c.key, cname = c.name, impact = h.impact
    | extend r = iff(impact == "Limited", 1, iff(impact == "Suppressed", 2, 0));
// per child: how many impacts its links ask for, and the highest of them
let asked = links
    | distinct ck, r
    | summarize kinds = count(), r = max(r) by ck;
// a child whose links all ask for one impact carries it; a child whose links ask for several carries Standard, and each other impact goes through a proxy
let entities = graph("model")
    | graph-match (e) where labels(e) has "ModelEntity"
      project ck = e.key, name = e.key, displayName = e.name, ignoreUnknown = e.ignoreUnknown,
              healthObjective = e.healthObjective, canvasX = e.canvasX, canvasY = e.canvasY,
              degradedAlert = e.degradedAlert, unhealthyAlert = e.unhealthyAlert, resourceHealth = e.resourceHealth;
let impacts = union
        (entities | project ck, kinds = 0, r = 0),
        (asked | project ck, kinds, r)
    | summarize kinds = sum(kinds), r = max(r) by ck
    | project ik = ck, impact = iff(kinds == 1 and r == 1, "Limited", iff(kinds == 1 and r == 2, "Suppressed", "Standard"));
let viaProxy = links
    | join kind=inner (asked | where kinds > 1 | project ck) on ck
    | where r > 0
    | project pk, ck, cname, impact, pname = strcat(ck, "--", tolower(impact));
let proxies = viaProxy | distinct ck, cname, impact, pname;

nodes HealthEntity on x = entities
    | join kind=inner (impacts) on $left.ck == $right.ik
    | project x = identity("healthEntity", ck), name, displayName, impact, ignoreUnknown, proxy = false,
              healthObjective, canvasX, canvasY, degradedAlert, unhealthyAlert, resourceHealth;
nodes HealthEntity on x = proxies
    | project x = identity("healthEntity", pname), name = pname, displayName = strcat(cname, " (", impact, ")"),
              impact, ignoreUnknown = true, proxy = true;
edges DependsOn from p to c = union
        (links | join kind=inner (asked | project ck, kinds) on ck | where kinds == 1 or r == 0 | project p = identity("healthEntity", pk), c = identity("healthEntity", ck)),
        (viaProxy | project p = identity("healthEntity", pk), c = identity("healthEntity", pname)),
        (proxies | project p = identity("healthEntity", pname), c = identity("healthEntity", ck));
