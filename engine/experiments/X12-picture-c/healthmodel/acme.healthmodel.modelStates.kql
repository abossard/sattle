graph modelStates : acme.healthmodel with (
    description = "The health model with the state of each resource: the state of the Deployment it names.",
    history = 4);
input model : acme.healthmodel;
input health : acme.deployhealth;

nodes ModelEntity on e = graph("model")
    | graph-match (e) where labels(e) has "ModelEntity"
      project e = e.id, key = e.key, name = e.name, role = e.role, ignoreUnknown = e.ignoreUnknown;
edges HasChild from p to c = graph("model")
    | graph-match (p)-[h]->(c) where labels(h) has "HasChild"
      project p = p.id, c = c.id, impact = h.impact;
extend nodes ModelEntity on e = graph("model")
    | graph-match (r) where labels(r) has "ModelEntity" and r.role == "resource"
      project e = r.id, rc = coalesce(r.cluster, ""), rn = coalesce(r.namespace, ""), rd = coalesce(r.deployment, "")
    | join kind=inner (graph("health") | graph-match (w) where labels(w) has "Workload" project wc = w.cluster, wn = w.namespace, wd = w.name, wstate = w.state)
      on $left.rc == $right.wc, $left.rn == $right.wn, $left.rd == $right.wd
    | project e, state = wstate;
