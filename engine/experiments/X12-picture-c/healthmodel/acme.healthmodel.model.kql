graph model : acme.healthmodel with (
    description = "The health model as authored: its entities and the links from parent to child, each link with the child's impact on that parent.",
    history = 4);
input entities : ModelEntityRow;
input links : ModelLinkRow;

nodes ModelEntity on e with (rule = "authoredEntities") = entities | project e = identity("modelEntity", key), key, name, role, ignoreUnknown, cluster, namespace, deployment,
      healthObjective, canvasX, canvasY, degradedAlert, unhealthyAlert, resourceHealth;
edges HasChild from p to c with (rule = "authoredLinks") = links | project p = identity("modelEntity", parent), c = identity("modelEntity", child), impact;
