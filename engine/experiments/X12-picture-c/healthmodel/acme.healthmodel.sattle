/// A health model: a root, user flows, system components and the resources they run on, linked parent to child. How much a child counts for its parent (its impact) is set on the link, so a child shared by two parents can count fully for one and less for the other. Resources take their state from deployment health; the states of the others are rolled up level by level.
module acme.healthmodel @ 1.0.0;

import acme.deployhealth @ 1.0.0 sha256:88b2dd8a8bf9fb5755a01b16cc3613d8f2f041159b7f1624b10bd518c6e957ed as dh;

/// An authored entity of the model. A resource names the Deployment it stands for.
rows ModelEntityRow { key: Text; name: Text; role: Text; ignoreUnknown: Boolean; cluster?: Text; namespace?: Text; deployment?: Text;
  healthObjective?: Integer; canvasX?: Integer; canvasY?: Integer; degradedAlert?: Text; unhealthyAlert?: Text; resourceHealth?: Boolean; }
/// An authored link from a parent to a child, with the child's impact on that parent: Standard, Limited or Suppressed.
rows ModelLinkRow { parent: Text; child: Text; impact: Text; }

/// One entity of the model. role is root, flow, component or resource; ignoreUnknown says whether the entity's roll-up leaves out children whose state is Unknown.
/// The fields the service also stores: healthObjective, the percentage of time the entity should be healthy (0 to 100); canvasX and canvasY, its place on the canvas;
/// degradedAlert and unhealthyAlert, the severity (Sev0 to Sev4) of the alert raised when it turns Degraded or Unhealthy; resourceHealth, whether a resource also reads Azure Resource Health.
entity ModelEntity {
  key: Text; name: Text label; role: Text; ignoreUnknown: Boolean;
  cluster?: Text; namespace?: Text; deployment?: Text;
  healthObjective?: Integer; canvasX?: Integer; canvasY?: Integer; degradedAlert?: Text; unhealthyAlert?: Text; resourceHealth?: Boolean;
  state?: Text roles { "Healthy": ok, "Degraded": warning, "Unhealthy": danger, "Unknown": unknown };
}
/// The parent's state depends on the child's. impact: Standard counts the child's state as it is, Limited one level milder (Unhealthy as Degraded, Degraded as Healthy), Suppressed not at all.
relationship HasChild (ModelEntity) -> (ModelEntity) hierarchy kind composition { impact: Text; }

identity modelEntity for ModelEntity version "1" { key: Text by exact; }

/// An entity of the health model in the form the service stores it, where impact belongs to the child entity and holds for all its parents. name is the resource name: the authored key, and for a proxy the key, two dashes and the impact.
/// A proxy stands between a child and the parents whose links ask for an impact other than Standard, when the child's links ask for more than one impact; it has the child as its only dependency and no signal, so it passes the child's state on unchanged.
entity HealthEntity {
  name: Text; displayName: Text label; impact: Text; ignoreUnknown: Boolean; proxy: Boolean;
  healthObjective?: Integer; canvasX?: Integer; canvasY?: Integer; degradedAlert?: Text; unhealthyAlert?: Text; resourceHealth?: Boolean;
}
/// The parent's health depends on the child's: one relationship resource of the service, which carries no impact.
relationship DependsOn (HealthEntity) -> (HealthEntity) hierarchy kind composition;

identity healthEntity for HealthEntity version "1" { name: Text by exact; }
