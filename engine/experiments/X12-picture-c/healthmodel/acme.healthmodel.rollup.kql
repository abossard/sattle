graph rollup : acme.healthmodel with (
    description = "One level of the roll-up: a parent's state is the worst over its children, each child counted through the impact on its link, an Unknown child left out where the parent ignores Unknown. An entity without children keeps its state. Stacked once per level.",
    history = 4);
input model : acme.healthmodel;

// severities: Healthy 0, Unknown 1 (counted), Degraded 2, Unhealthy 3; -1 is not counted
let own = graph("model")
    | graph-match (e) where labels(e) has "ModelEntity"
      project e = e.id, s = coalesce(e.state, "Unknown")
    | project e, kids = 0, own = iff(s == "Unhealthy", 3, iff(s == "Degraded", 2, iff(s == "Healthy", 0, -1))), worst = -1;
let children = graph("model")
    | graph-match (p)-[h]->(c) where labels(h) has "HasChild"
      project e = p.id, impact = h.impact, s = coalesce(c.state, "Unknown"), ignore = p.ignoreUnknown
    | project e, impact, v = iff(s == "Unhealthy", 3, iff(s == "Degraded", 2, iff(s == "Healthy", 0, iff(ignore, -1, 1))))
    | project e, kids = 1, own = -1, worst = iff(impact == "Suppressed", -1, iff(impact == "Limited" and v == 3, 2, iff(impact == "Limited" and v == 2, 0, v)));
let states = union own, children
    | summarize kids = sum(kids), own = max(own), worst = max(worst) by e
    | project e, v = iff(kids > 0, worst, own)
    | project e, state = iff(v == 3, "Unhealthy", iff(v == 2, "Degraded", iff(v == 0, "Healthy", "Unknown")));

nodes ModelEntity on e = graph("model")
    | graph-match (e) where labels(e) has "ModelEntity"
      project e = e.id, key = e.key, name = e.name, role = e.role, ignoreUnknown = e.ignoreUnknown;
edges HasChild from p to c = graph("model")
    | graph-match (p)-[h]->(c) where labels(h) has "HasChild"
      project p = p.id, c = c.id, impact = h.impact;
extend nodes ModelEntity on e = states;
