{
  "graph": "rollup",
  "ontology": "acme.healthmodel",
  "description": "One level of the roll-up: a parent's state is the worst over its children, each child counted through the impact on its link, an Unknown child left out where the parent ignores Unknown. An entity without children keeps its state. Stacked once per level.",
  "history": 4,
  "inputs": [{"name": "model", "ontology": "acme.healthmodel"}],
  "parameters": [],
  "verbs": [
    {"id": "entities", "verb": "graph-match", "graph": "model", "pattern": {"nodes": [{"var": "e", "label": "ModelEntity"}]}},
    {"id": "copyEntities", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ModelEntity", "id": {"ref": "e"}, "props": {"key": {"ref": "e.key"}, "name": {"ref": "e.name"}, "role": {"ref": "e.role"}, "ignoreUnknown": {"ref": "e.ignoreUnknown"}}}]}},
    {"id": "links", "verb": "graph-match", "graph": "model", "pattern": {"nodes": [{"var": "p", "label": "ModelEntity"}, {"var": "c", "label": "ModelEntity"}], "edges": [{"var": "h", "label": "HasChild", "from": "p", "to": "c"}]}},
    {"id": "copyLinks", "verb": "edges", "target": {"nodes": [{"var": "s", "label": "ModelEntity", "id": {"ref": "p"}}, {"var": "t", "label": "ModelEntity", "id": {"ref": "c"}}], "edges": [{"var": "k", "label": "HasChild", "from": "s", "to": "t", "props": {"impact": {"ref": "h.impact"}}}]}},
    {"id": "ownState", "verb": "project", "columns": {"e": {"ref": "e"}, "s": {"fn": "coalesce", "args": [{"ref": "e.state"}, {"lit": "Unknown"}]}}},
    {"id": "own", "verb": "project", "columns": {"e": {"ref": "e"}, "kids": {"lit": 0}, "own": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "s"}, {"lit": "Unhealthy"}]}, {"lit": 3}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "s"}, {"lit": "Degraded"}]}, {"lit": 2}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "s"}, {"lit": "Healthy"}]}, {"lit": 0}, {"lit": -1}]}]}]}, "worst": {"lit": -1}}},
    {"id": "childState", "verb": "project", "columns": {"e": {"ref": "p"}, "impact": {"ref": "h.impact"}, "s": {"fn": "coalesce", "args": [{"ref": "c.state"}, {"lit": "Unknown"}]}, "ignore": {"ref": "p.ignoreUnknown"}}},
    {"id": "severity", "verb": "project", "columns": {"e": {"ref": "e"}, "impact": {"ref": "impact"}, "v": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "s"}, {"lit": "Unhealthy"}]}, {"lit": 3}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "s"}, {"lit": "Degraded"}]}, {"lit": 2}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "s"}, {"lit": "Healthy"}]}, {"lit": 0}, {"fn": "iff", "args": [{"ref": "ignore"}, {"lit": -1}, {"lit": 1}]}]}]}]}}},
    {"id": "impacted", "verb": "project", "columns": {"e": {"ref": "e"}, "kids": {"lit": 1}, "own": {"lit": -1}, "worst": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "impact"}, {"lit": "Suppressed"}]}, {"lit": -1}, {"fn": "iff", "args": [{"fn": "and", "args": [{"fn": "==", "args": [{"ref": "impact"}, {"lit": "Limited"}]}, {"fn": "==", "args": [{"ref": "v"}, {"lit": 3}]}]}, {"lit": 2}, {"fn": "iff", "args": [{"fn": "and", "args": [{"fn": "==", "args": [{"ref": "impact"}, {"lit": "Limited"}]}, {"fn": "==", "args": [{"ref": "v"}, {"lit": 2}]}]}, {"lit": 0}, {"ref": "v"}]}]}]}}},
    {"id": "rows", "verb": "union"},
    {"id": "perEntity", "verb": "summarize", "aggregates": {"kids": {"fn": "sum", "args": [{"ref": "kids"}]}, "own": {"fn": "max", "args": [{"ref": "own"}]}, "worst": {"fn": "max", "args": [{"ref": "worst"}]}}, "by": {"e": {"ref": "e"}}},
    {"id": "pick", "verb": "project", "columns": {"e": {"ref": "e"}, "v": {"fn": "iff", "args": [{"fn": ">", "args": [{"ref": "kids"}, {"lit": 0}]}, {"ref": "worst"}, {"ref": "own"}]}}},
    {"id": "named", "verb": "project", "columns": {"e": {"ref": "e"}, "state": {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "v"}, {"lit": 3}]}, {"lit": "Unhealthy"}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "v"}, {"lit": 2}]}, {"lit": "Degraded"}, {"fn": "iff", "args": [{"fn": "==", "args": [{"ref": "v"}, {"lit": 0}]}, {"lit": "Healthy"}, {"lit": "Unknown"}]}]}]}}},
    {"id": "rolledUp", "verb": "nodes", "target": {"nodes": [{"var": "n", "label": "ModelEntity", "id": {"ref": "e"}, "extend": true, "props": {"state": {"ref": "state"}}}]}}
  ],
  "wires": [
    {"from": "entities", "to": "copyEntities"},
    {"from": "links", "to": "copyLinks"},
    {"from": "entities", "to": "ownState"},
    {"from": "ownState", "to": "own"},
    {"from": "links", "to": "childState"},
    {"from": "childState", "to": "severity"},
    {"from": "severity", "to": "impacted"},
    {"from": "own", "to": "rows"},
    {"from": "impacted", "to": "rows"},
    {"from": "rows", "to": "perEntity"},
    {"from": "perEntity", "to": "pick"},
    {"from": "pick", "to": "named"},
    {"from": "named", "to": "rolledUp"}
  ]
}
