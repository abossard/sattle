/// Business capability view. Rename, re-parent, create and retire capabilities here.
module acme.biz @ 1.0.0;

import sattle.infra @ 1.0.0 sha256:19546ef2ea99f86ed96fb4d8081307b0b29d28bb14f5dd9b1b5ee580f9959ec3 as infra;
import acme.ops     @ 1.0.0 sha256:c075118585cca4bfb0818157e799884854d6b0a6070bd29930c5605c396a262b as ops;
import acme.svc     @ 1.0.0 sha256:fa6005495c9fc9329a5ffbbb02313ef6a3c7b78eab8409e9f43e5f0c6630145d as svc;

entity BizCapability { name: Text label; serviceCount?: Integer; }
relationship Under (BizCapability) -> (BizCapability) kind composition;
/// The service dependencies lifted to the capabilities that realize their ends. The properties carry the lifted calls: their names differ from those of the service-level DependsOn (acme.svc), because a property name that two modules declare is served qualified, and the service tree's names must not change.
relationship DependsOn (BizCapability) -> (BizCapability) kind communication {
  callStatus?: Text;
  callFlows?: Integer telemetry delta sum every 60s;
  callDrops?: Integer telemetry delta sum every 60s;
  callDropRatio?: Decimal telemetry gauge max every 60s;
}
constraint cardinality Under per source 0 .. 1;
constraint enum DependsOn.callStatus in ["ok", "degraded"];
constraint acyclic Under;

/// The business capabilities and the calls between them, lifted from the calls between the services that realize them.
projection capabilityView view output acme.biz {
  in authored: graph ops;
  in tree: graph svc;
  retain 8;

  rule capabilities lens {
    let active = match authored (c: ops.Capability) |> where c.status != "retired";
    emit entity BizCapability from active identity c set { name: c.name };
    accept create, delete, update(name);
    on create key ops.capability default { capId: key.id, owner: "unassigned", status: "active" };
    on delete set { status: "retired" };
  }

  rule tree lens {
    let links = match authored (c: ops.Capability)-[:ops.PartOf]->(p: ops.Capability)
      |> where c.status != "retired" and p.status != "retired";
    emit relationship Under from links key under: c -> p;
    accept create, delete;
  }

  rule counts readonly "number of services realizing the capability" {
    let realized = match authored (s: infra.Service)-[:ops.Realizes]->(c: ops.Capability)
      |> where c.status != "retired";
    let perCap = realized |> group by { c: c } aggregate { services: countDistinct(s) };
    emit update entity BizCapability from perCap identity c set { serviceCount: services };
  }

  // The service dependencies lifted one level: each service is mapped to the capability that realizes it (Realizes is a function), an edge between two services becomes an edge between their capabilities.
  // Calls inside one capability and calls of a service that realizes no capability are not lifted; parallel edges collapse onto one, flows and drops are summed, the ratio is recomputed from the sums
  // and the state is derived again from it. The properties carry their own names (a name two modules declare is served qualified, and the service tree's names must not change).
  rule lifted readonly "service dependencies lifted to the capabilities that realize their ends" {
    let dependsOn__edges = match tree (source: svc.ServiceNode)-[edge: svc.DependsOn]->(target: svc.ServiceNode);
    let dependsOn__images = match authored (node: infra.Service)-[:ops.Realizes]->(image: ops.Capability)
      |> where image.status != "retired";
    let dependsOn__imagePairs = dependsOn__images |> select { m: node, i: image };
    let dependsOn__counted = dependsOn__imagePairs |> group by { m: m } aggregate { n: count() } |> select { mk: m, n: n };
    let dependsOn__pairs = dependsOn__imagePairs;
    let dependsOn__joined = join dependsOn__pairs, dependsOn__counted on m == mk;
    let dependsOn__single = dependsOn__joined |> where n == 1;
    let dependsOn__from = dependsOn__single |> select { sourceMapped: m, sourceImage: i };
    let dependsOn__to = dependsOn__single |> select { targetMapped: m, targetImage: i };
    let dependsOn__fromEnd = join dependsOn__edges, dependsOn__from on entityId(source) == entityId(sourceMapped);
    let dependsOn__ends = join dependsOn__fromEnd, dependsOn__to on entityId(target) == entityId(targetMapped);
    let dependsOn__lifted = dependsOn__ends |> where sourceImage != targetImage;
    emit relationship DependsOn from dependsOn__lifted key dependsOn: sourceImage -> targetImage;
    let dependsOn__windows = dependsOn__lifted
      |> series tree edge.flows, edge.drops within 24h
      |> rollup by { sourceImage: sourceImage, targetImage: targetImage } combine { callFlows: sum(flows), callDrops: sum(drops) };
    let dependsOn = dependsOn__windows |> select { src: sourceImage, dst: targetImage, windowStart: windowStart, callFlows: callFlows, callDrops: callDrops, callDropRatio: if(callFlows > 0, callDrops / callFlows, 0.0) };
    emit update relationship DependsOn from dependsOn key dependsOn: src -> dst set { callFlows: callFlows, callDrops: callDrops, callDropRatio: callDropRatio };
    let dependsOn__state0 = dependsOn |> threshold callDropRatio by { src: src, dst: dst } above 0.05 for 3 then "degraded" below 0.02 for 3 then "ok" initial "ok" as callStatus;
    emit update relationship DependsOn from dependsOn__state0 key dependsOn: src -> dst set { callStatus: callStatus };
  }
}
