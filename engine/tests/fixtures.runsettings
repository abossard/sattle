<?xml version="1.0" encoding="utf-8"?>
<!-- Only the tests of Category=Fixtures: the replays of lab/fixtures, the scrubbed excerpt of a real capture (generated locally with lab/fixtures/build.sh, gitignored). Without the data they are skipped with the reason. Run from engine/ with: dotnet test, then the settings option naming this file. It replaces the default filter of each project. -->
<RunSettings>
  <RunConfiguration><TestCaseFilter>Category=Fixtures</TestCaseFilter></RunConfiguration>
</RunSettings>
