<?xml version="1.0" encoding="utf-8"?>
<!-- Only the tests of Category=Slow, in every test project: restart, seal, live resume, history retention, snapshots, refactoring, lenses, drafts, forwarder markers, and the differential harness at many seeds. Run from engine/ with: dotnet test, then the settings option naming this file. It replaces the default filter of each project (Category!=Capture and Category!=Slow). -->
<RunSettings>
  <RunConfiguration><TestCaseFilter>Category=Slow</TestCaseFilter></RunConfiguration>
</RunSettings>
