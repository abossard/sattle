<?xml version="1.0" encoding="utf-8"?>
<!-- The default run: the differential harness at its small seed count and the known-defect tests (Category=KnownDefect, each fails until its defect is fixed). Category=Slow is the harness at many seeds. -->
<RunSettings>
  <RunConfiguration><TestCaseFilter>Category!=Slow</TestCaseFilter></RunConfiguration>
</RunSettings>
