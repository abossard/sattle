<?xml version="1.0" encoding="utf-8"?>
<!-- Only the tests of Category=Capture: the replays of the real captures under lab/captures (gitignored). Run from engine/ with: dotnet test, then the settings option naming this file. It replaces the default filter of each project (Category!=Capture and Category!=Slow). -->
<RunSettings>
  <RunConfiguration><TestCaseFilter>Category=Capture</TestCaseFilter></RunConfiguration>
</RunSettings>
