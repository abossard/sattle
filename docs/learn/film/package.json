{
  "name": "sattle-health-film",
  "private": true,
  "type": "module",
  "devDependencies": {
    "hyperframes": "0.8.146"
  },
  "scripts": {
    "dev": "hyperframes preview",
    "check": "hyperframes check",
    "render": "hyperframes render --quality delivery --fps 24 --output renders/film.mp4 && python3 -B package_video.py renders/film.mp4",
    "voice": ".narrator/venv/bin/python -B build.py",
    "voice:retail": ".narrator/venv/bin/python -B build.py --retail",
    "check:retail": "python3 -B package_video.py --retail --check",
    "render:retail": "python3 -B package_video.py --retail --render"
  }
}
