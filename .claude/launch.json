      "port": 5080
    },
    {
      "name": "sattle-engine-capture",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["engine/src/Sattle.Cli/bin/Release/net10.0/sattle.dll", "serve", "latest", "--port", "5080"],
      "port": 5080
    },
    {
      "name": "sattle-engine-health",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["engine/src/Sattle.Cli/bin/Release/net10.0/sattle.dll", "serve", "engine/tests/Sattle.Tests/fixtures/deploy-health", "--port", "5080"],
      "port": 5080
    },
    {
      "name": "sattle-engine-estate",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["engine/src/Sattle.Cli/bin/Release/net10.0/sattle.dll", "serve", "engine/tests/Sattle.Tests/fixtures/estate", "--cluster", "synth", "--port", "5080"],
      "port": 5080
    },
    {
      "name": "sattle-engine-capture-b",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["engine/src/Sattle.Cli/bin/Release/net10.0/sattle.dll", "serve", "latest", "--port", "5081"],
      "port": 5081
    },
    {
      "name": "sattle-canvas-b",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ENGINE_PORT=5081", "npm", "--prefix", "canvas", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "sattle-canvas",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "canvas", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
