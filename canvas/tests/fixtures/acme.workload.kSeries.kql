// Series with threshold, a reference projection of research note 09 (section 1) that has no file in the definitions: the drop rate of each
// node over a day, rolled up per window, with a state that turns on and off after two windows past its limits; and the activity events per
// operation and minute. Its state digest is that of the projection its recorded walkthrough built with the old operator commands.
graph kSeries : acme.workload with (history = 4);
input master : acme.ops;
input structure : acme.workload;

let warnOn = graph("master")
    | graph-match (nd) where labels(nd) has "Node"
      project nd = nd.id, c = nd.name
    | join kind=inner (telemetry("master", 24h) | where property == "dropRate" | project k = id, windowStart, property, value) on $left.nd == $right.k
    | summarize v = max(value), s = sum(value) by c, windowStart
    | project c, windowStart, value = v, above = 0.01, enterAfter = 2, below = 0.005, exitAfter = 2
    | invoke hysteresis("on", "off", "off");
nodes ComponentSignal on sig = warnOn
    | project sig = identity("signal", c, "drop rate"), componentKey = c, meter = "dropRate", rule = "drop rate", signalSeverity = 2, signalState = state;
let acts = graph("master")
    | graph-match (ev) where labels(ev) has "ActivityEvent"
      project t = ev.['time'], c = ev.operation
    | summarize n = count() by c, windowStart = bin(t, 1m);
nodes ComponentSignal on sig = acts
    | project sig = identity("signal", strcat("evt/", c), "activity"), componentKey = strcat("evt/", c), meter = c, rule = "activity", signalSeverity = n, signalState = "off";
