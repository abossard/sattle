{
 "module": "acme.healthmodel",
 "name": "kSeries",
 "nonEmpty": true,
 "graphs": [
  "kSeries"
 ],
 "text": [
  "projection NAME view forward output health {",
  "  in master: graph ops;",
  "  in st: graph health;",
  "  retain 4;",
  "  let ser = match master (nd: infra.Node)",
  "    |> series master nd.dropRate within 24h;",
  "  let warn = ser",
  "    |> rollup by { c: nd.name } combine { m: mean(dropRate), n: count(), s: sum(dropRate), v: max(dropRate) };",
  "  let warnOn = warn",
  "    |> threshold v by { c: c } above 0.01 for 2 then \"on\" below 0.005 for 2 then \"off\" initial \"off\" as degraded;",
  "  let acts = match master (ev: azure.ActivityEvent)",
  "    |> select { t: ev.time, c: ev.operation }",
  "    |> window on t width 1m late ignore",
  "    |> group by { c: c, windowStart: windowStart } aggregate { n: count() };",
  "  emit entity health.Signal from warnOn",
  "    identity health.signal(component: c, name: \"drop rate\")",
  "    set { component: c, degraded: degraded, name: \"drop rate\" };",
  "  emit entity health.Component from acts",
  "    identity health.component(id: concat(\"evt/\", c))",
  "    set { key: concat(\"evt/\", c), kind: \"activity\", name: c, own: n };",
  "}"
 ],
