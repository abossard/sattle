  "narrative": {
    "northStar": "The Drawing Sheet",
    "overview": "Paper, ink, a ruled frame and one drafting blue, on Fluent UI v9. A projection is a sheet with numbered parts, lettered zones and a title block.",
    "keyCharacteristics": [
      "Paper and ink neutrals, near square corners, hairline rules.",
      "One hue: drafting blue, for selection, focus, caret and live wires.",
      "Amber and red stay with diagnostics and errors.",
      "Tabular figures; monospace for references.",
      "Frame, ticks, balloons, title block."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Drafting blue means selected, focused or live. Any other use of blue is wrong.",
        "section": "colors"
      },
      {
        "name": "The Ink Does the Work Rule",
        "body": "Structure is drawn in ink and rule weights, not in tinted fills. Amber and red belong to diagnostics only.",
        "section": "colors"
      },
      {
        "name": "The Reference Is Mono Rule",
        "body": "Anything that names a place or an id is set in the monospace.",
        "section": "typography"
      },
      {
        "name": "The Rule Weight Rule",
        "body": "On the sheet, importance is stroke width and dash pattern.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use Fluent components and theme tokens; change the look in theme.ts.",
      "Draw the sheet in ink, with stroke weight and dash pattern carrying meaning.",
      "Use drafting blue only for selection, focus, caret and live wires.",
      "Keep corners at 4px or less.",
      "Set zone labels, part numbers, ports and ids in the monospace."
    ],
    "donts": [
      "Put amber or red on anything that is not a diagnostic or an error.",
      "Use soft large shadows, gradient fills or rounded cards.",
      "Let a badge stretch to the width of its column.",
      "Introduce a second accent hue."
    ]
  }
