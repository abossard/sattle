{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentityEntry",
  "$ref": "#/$defs/IdentityEntry",
  "$defs": {
    "TenantId": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "IdentityDomain": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "TextValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "IntegerValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "integer"
        },
        "value": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "DecimalValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "decimal"
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]\u002B)?$"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "BooleanValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "InstantValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "instant"
        },
        "value": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "NullValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "null"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "EntityId": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "EntityValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "entity"
        },
        "value": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ListValue": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "list"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphValue"
          }
        }
      },
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false
    },
    "GraphValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/TextValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/DecimalValue"
        },
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/InstantValue"
        },
        {
          "$ref": "#/$defs/NullValue"
        },
        {
          "$ref": "#/$defs/EntityValue"
        },
        {
          "$ref": "#/$defs/ListValue"
        }
      ]
    },
    "IdentityComponent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/GraphValue"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "IdentityKey": {
      "type": "object",
      "properties": {
        "tenant": {
          "$ref": "#/$defs/TenantId"
        },
        "domain": {
          "$ref": "#/$defs/IdentityDomain"
        },
        "canonicalizationVersion": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IdentityComponent"
          }
        }
      },
      "required": [
        "tenant",
        "domain",
        "canonicalizationVersion",
        "components"
      ],
      "additionalProperties": false
    },
    "IdentityEntry": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/IdentityKey"
        },
        "entity": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "key",
        "entity"
      ],
      "additionalProperties": false
    }
  }
}