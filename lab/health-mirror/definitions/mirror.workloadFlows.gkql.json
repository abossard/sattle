      }
    },
    {
      "id": "requiredClasses",
      "verb": "project",
      "columns": {
        "step": {"ref": "s"},
        "stepKey": {"ref": "s.key"},
        "classId": {"ref": "c"},
        "className": {"ref": "c.className"},
        "evidence": {"ref": "req.evidence"}
      }
    },
    {
      "id": "classifiedApps",
      "verb": "graph-match",
      "graph": "containerApps",
      "pattern": {
        "nodes": [{"var": "a", "label": "ContainerApp"}, {"var": "c", "label": "AppClass"}],
        "edges": [{"var": "classified", "label": "ClassifiedAs", "from": "a", "to": "c"}]
      }
    },
    {
      "id": "actualClasses",
      "verb": "project",
      "columns": {"app": {"ref": "a"}, "mappedId": {"ref": "c"}, "appState": {"ref": "a.state"}}
    },
    {
      "id": "resolveRequiredClass",
      "verb": "join",
      "kind": "inner",
      "on": [{"left": "classId", "right": "mappedId"}]
    },
    {
      "id": "runsOnApp",
      "verb": "edges",
      "target": {
        "nodes": [
          {"var": "a", "label": "SystemComponent", "id": {"ref": "step"}},
          {"var": "b", "label": "ContainerApp", "id": {"ref": "app"}}
        ],
        "edges": [
          {
            "var": "edge",
            "label": "RunsOnApp",
            "from": "a",
            "to": "b",
            "props": {
              "provenance": {"lit": "LocalOntology"},
              "className": {"ref": "className"},
              "evidence": {"ref": "evidence"}
            }
          }
        ]
      }
    },
    {
      "id": "flowSteps",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {
        "nodes": [{"var": "f", "label": "UserFlow"}, {"var": "s", "label": "SystemComponent"}],
        "edges": [{"var": "path", "label": "DeclaresStep", "from": "f", "to": "s"}]
      }
    },
    {
      "id": "declaredSteps",
      "verb": "edges",
      "target": {
        "nodes": [
          {"var": "a", "label": "UserFlow", "id": {"ref": "f"}},
          {"var": "b", "label": "SystemComponent", "id": {"ref": "s"}}
        ],
        "edges": [
          {
            "var": "edge",
            "label": "DeclaresStep",
            "from": "a",
            "to": "b",
            "props": {"provenance": {"ref": "path.provenance"}, "evidence": {"ref": "path.evidence"}}
          }
        ]
      }
    },
    {
      "id": "appDeploymentRanks",
      "verb": "project",
      "columns": {
        "key": {"ref": "stepKey"},
        "rank": {
          "fn": "iff",
          "args": [
            {"fn": "==", "args": [{"ref": "appState"}, {"lit": "Unknown"}]},
            {"lit": 0},
            {
              "fn": "iff",
              "args": [
                {"fn": "==", "args": [{"ref": "appState"}, {"lit": "Healthy"}]},
                {"lit": 1},
                {
                  "fn": "iff",
                  "args": [
                    {"fn": "==", "args": [{"ref": "appState"}, {"lit": "Degraded"}]},
                    {"lit": 2},
                    {
                      "fn": "iff",
                      "args": [
                        {"fn": "==", "args": [{"ref": "appState"}, {"lit": "Unhealthy"}]},
                        {"lit": 3},
                        {"lit": 0}
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "declaredSystemComponent",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {"nodes": [{"var": "s", "label": "SystemComponent"}]}
    },
    {
      "id": "SystemComponentKeys",
      "verb": "project",
      "columns": {"role": {"ref": "s"}, "roleKey": {"ref": "s.key"}}
    },
    {"id": "allSystemComponent", "verb": "project", "columns": {"key": {"ref": "s.key"}, "rank": {"lit": 0}}},
    {"id": "SystemComponentDeploymentInputs", "verb": "union"},
    {
      "id": "SystemComponentDeployment",
      "verb": "summarize",
