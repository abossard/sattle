        "severity": {"fn": "max", "args": [{"ref": "severity"}]},
        "sourceRank": {"fn": "max", "args": [{"ref": "sourceRank"}]}
      }
    },
    {
      "id": "checkCoverage",
      "verb": "project",
      "columns": {
        "systemKey": {"ref": "stepKey"},
        "severity": {
          "fn": "iff",
          "args": [{"fn": "==", "args": [{"ref": "severity"}, {"lit": 0}]}, {"lit": 2}, {"ref": "severity"}]
        },
        "expected": {"lit": 1},
        "measured": {
          "fn": "iff",
          "args": [{"fn": "==", "args": [{"ref": "sourceRank"}, {"lit": 0}]}, {"lit": 0}, {"lit": 1}]
        },
        "sourceRank": {"ref": "sourceRank"}
      }
    },
    {
      "id": "allDeclaredSteps",
      "verb": "project",
      "columns": {
        "systemKey": {"ref": "s.key"},
