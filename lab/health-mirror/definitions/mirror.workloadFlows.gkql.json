        "step": {"ref": "s"},
        "stepKey": {"ref": "s.key"},
        "selector": {"ref": "b.selector"},
        "evidence": {"ref": "binding.evidence"}
      }
    },
    {
      "id": "observedWindows",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {"nodes": [{"var": "w", "label": "OperationWindow"}]}
    },
    {
      "id": "scopedIngressEvidence",
      "verb": "where",
      "condition": {
        "fn": "and",
        "args": [
          {"fn": ">", "args": [{"ref": "w.attributedCalls"}, {"lit": 0}]},
          {"fn": "!=", "args": [{"ref": "w.role"}, {"lit": ""}]}
        ]
      }
    },
    {
      "id": "observedSelectors",
      "verb": "project",
      "columns": {"observedSelector": {"ref": "w.selector"}, "window": {"ref": "w"}}
    },
    {
      "id": "matchedOperation",
      "verb": "join",
      "kind": "inner",
      "on": [{"left": "selector", "right": "observedSelector"}]
    },
    {
      "id": "operationEvidence",
      "verb": "nodes",
      "target": {
        "nodes": [
          {
            "var": "result",
            "label": "OperationWindow",
            "id": {"ref": "window"},
            "props": {
              "scopeId": {"ref": "window.scopeId"},
              "componentId": {"ref": "window.componentId"},
              "source": {"ref": "window.source"},
              "role": {"ref": "window.role"},
              "operation": {"ref": "window.operation"},
              "windowStart": {"ref": "window.windowStart"},
              "windowEnd": {"ref": "window.windowEnd"},
              "lastSeen": {"ref": "window.lastSeen"},
              "selector": {"ref": "window.selector"},
              "relationship": {"ref": "window.relationship"},
              "evidenceType": {"ref": "window.evidenceType"},
              "target": {"ref": "window.target"},
              "ingressHosts": {"ref": "window.ingressHosts"},
              "calls": {"ref": "window.calls"},
              "spanCount": {"ref": "window.spanCount"},
              "failed": {"ref": "window.failed"},
              "unknown": {"ref": "window.unknown"},
              "attributedCalls": {"ref": "window.attributedCalls"},
              "attributedFailed": {"ref": "window.attributedFailed"},
              "attributedUnknown": {"ref": "window.attributedUnknown"}
            }
          }
        ]
      }
    },
    {
      "id": "evidenceForStep",
      "verb": "edges",
      "target": {
        "nodes": [
          {"var": "a", "label": "SystemComponent", "id": {"ref": "step"}},
          {"var": "b", "label": "OperationWindow", "id": {"ref": "window"}}
        ],
        "edges": [
          {
            "var": "edge",
            "label": "ObservedOperation",
            "from": "a",
            "to": "b",
            "props": {"provenance": {"ref": "window.source"}, "evidence": {"ref": "evidence"}}
          }
        ]
      }
    },
    {
      "id": "expectedOperations",
      "verb": "project",
      "columns": {
        "stepKey": {"ref": "stepKey"},
        "selector": {"ref": "selector"},
        "severity": {"lit": 0},
        "sourceRank": {"lit": 0}
      }
    },
    {
      "id": "observedOperations",
      "verb": "project",
      "columns": {
        "stepKey": {"ref": "stepKey"},
        "selector": {"ref": "selector"},
        "severity": {
          "fn": "iff",
          "args": [
            {"fn": "==", "args": [{"ref": "window.attributedFailed"}, {"ref": "window.attributedCalls"}]},
            {"lit": 4},
            {
              "fn": "iff",
              "args": [
                {"fn": ">", "args": [{"ref": "window.attributedFailed"}, {"lit": 0}]},
                {"lit": 3},
                {
                  "fn": "iff",
                  "args": [
                    {"fn": ">", "args": [{"ref": "window.attributedUnknown"}, {"lit": 0}]},
                    {"lit": 2},
                    {"lit": 1}
                  ]
                }
              ]
            }
          ]
        },
        "sourceRank": {
          "fn": "iff",
          "args": [{"fn": "==", "args": [{"ref": "window.source"}, {"lit": "AppDependencies"}]}, {"lit": 2}, {"lit": 1}]
        }
      }
    },
    {"id": "pendingAndObserved", "verb": "union"},
    {
      "id": "oneScorePerSelector",
      "verb": "summarize",
      "by": {"stepKey": {"ref": "stepKey"}, "selector": {"ref": "selector"}},
