              "armId": {"ref": "a.armId"},
              "armKey": {"ref": "a.armKey"},
              "name": {"ref": "a.name"},
              "resourceType": {"ref": "a.resourceType"},
              "location": {"ref": "a.location"},
              "subscriptionId": {"ref": "a.subscriptionId"},
              "resourceGroup": {"ref": "a.resourceGroup"},
              "groupId": {"ref": "a.groupId"},
              "environmentId": {"ref": "a.environmentId"},
              "provisioningState": {"ref": "a.provisioningState"},
              "runningStatus": {"ref": "a.runningStatus"},
              "ingressHost": {"ref": "a.ingressHost"},
              "tags": {"ref": "a.tags"},
              "observedAt": {"ref": "a.observedAt"},
              "state": {"ref": "a.state"},
              "assignment": {"ref": "a.assignment"},
              "ontologyStatus": {"ref": "a.ontologyStatus"},
              "classCount": {"ref": "a.classCount"},
              "healthBasis": {"ref": "a.healthBasis"}
