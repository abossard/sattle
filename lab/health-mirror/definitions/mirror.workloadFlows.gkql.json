                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "rank"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
