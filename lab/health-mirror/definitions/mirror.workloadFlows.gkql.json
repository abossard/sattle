        "severity": {"fn": "max", "args": [{"ref": "severity"}]},
        "sourceRank": {"fn": "max", "args": [{"ref": "sourceRank"}]},
        "measured": {"fn": "sum", "args": [{"ref": "measured"}]},
        "expected": {"fn": "sum", "args": [{"ref": "expected"}]}
      }
    },
    {"id": "evaluatedSteps", "verb": "join", "kind": "inner", "on": [{"left": "roleKey", "right": "systemKey"}]},
    {
      "id": "SystemComponentHealth",
      "verb": "nodes",
      "target": {
        "nodes": [
          {
            "var": "result",
            "label": "SystemComponent",
            "id": {"ref": "role"},
            "props": {
              "key": {"ref": "role.key"},
              "name": {"ref": "role.name"},
              "modelKey": {"ref": "role.modelKey"},
              "provenance": {"ref": "role.provenance"},
              "configuration": {"ref": "role.configuration"},
              "deploymentState": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "rank"}, {"lit": 3}]},
                  {"lit": "Unhealthy"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "rank"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
                  }
                ]
              },
              "measuredChecks": {"ref": "measured"},
              "expectedChecks": {"ref": "expected"},
              "state": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "severity"}, {"lit": 4}]},
                  {"lit": "Unhealthy"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "severity"}, {"lit": 3}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "severity"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
                  }
                ]
              },
              "evidenceKind": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "sourceRank"}, {"lit": 2}]},
                  {"lit": "MeasuredOperations"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "sourceRank"}, {"lit": 1}]},
                      {"lit": "MeasuredRequests"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "rank"}, {"lit": 0}]},
                          {"lit": "Unknown"},
                          {"lit": "DeploymentOnly"}
                        ]
                      }
                    ]
                  }
                ]
              },
              "healthBasis": {
                "fn": "iff",
                "args": [
                  {"fn": ">", "args": [{"ref": "measured"}, {"lit": 0}]},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "<", "args": [{"ref": "measured"}, {"ref": "expected"}]},
                      {"lit": "Some configured operations lack observations"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "sourceRank"}, {"lit": 2}]},
                          {"lit": "Direct child operations at the measured ingress"},
                          {"lit": "HTTP response outcomes at the measured ingress"}
                        ]
                      }
                    ]
                  },
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "rank"}, {"lit": 0}]},
                      {"lit": "No deployment or operation observation"},
                      {"lit": "ARM deployment state only"}
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "id": "flowStepScores",
      "verb": "join",
      "kind": "inner",
      "on": [{"left": "componentKey", "right": "systemKey"}]
    },
    {
      "id": "rollUpMeasurements",
