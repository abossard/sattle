    },
    {
      "id": "SystemComponentOperationalContext",
      "verb": "join",
      "kind": "inner",
      "on": [{"left": "roleKey", "right": "key"}]
    },
    {
      "id": "curatedSteps",
      "verb": "project",
      "columns": {"flowKey": {"ref": "f.key"}, "componentKey": {"ref": "s.key"}}
    },
    {"id": "deployedSteps", "verb": "join", "kind": "inner", "on": [{"left": "componentKey", "right": "key"}]},
    {
      "id": "stepDeploymentRanks",
      "verb": "project",
      "columns": {"key": {"ref": "flowKey"}, "rank": {"ref": "rank"}}
    },
    {
      "id": "declaredUserFlow",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {"nodes": [{"var": "f", "label": "UserFlow"}]}
    },
    {"id": "UserFlowKeys", "verb": "project", "columns": {"role": {"ref": "f"}, "roleKey": {"ref": "f.key"}}},
    {"id": "allUserFlow", "verb": "project", "columns": {"key": {"ref": "f.key"}, "rank": {"lit": 0}}},
    {"id": "UserFlowDeploymentInputs", "verb": "union"},
    {
      "id": "UserFlowDeployment",
      "verb": "summarize",
      "by": {"key": {"ref": "key"}},
      "aggregates": {"rank": {"fn": "max", "args": [{"ref": "rank"}]}}
    },
    {
      "id": "UserFlowOperationalContext",
      "verb": "join",
      "kind": "inner",
      "on": [{"left": "roleKey", "right": "key"}]
    },
    {
      "id": "requestTargets",
      "verb": "graph-match",
      "graph": "network",
      "pattern": {
        "nodes": [{"var": "source", "label": "ApplicationRole"}, {"var": "h", "label": "DependencyHost"}],
        "edges": [{"var": "call", "label": "CalledEndpoint", "from": "source", "to": "h"}]
      }
    },
    {
      "id": "measuredHosts",
      "verb": "project",
