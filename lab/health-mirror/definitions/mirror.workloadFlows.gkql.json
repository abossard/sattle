    {
      "id": "callsToExactIngress",
      "verb": "join",
      "kind": "inner",
      "on": [{"left": "hostKey", "right": "ingress"}]
    },
    {
      "id": "measuredTarget",
      "verb": "nodes",
      "target": {
        "nodes": [
