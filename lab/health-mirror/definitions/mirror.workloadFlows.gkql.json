{
  "graph": "workloadFlows",
  "ontology": "mirror",
  "description": "Resolve each project step against the unambiguous classes of deployed apps.",
  "history": 240,
  "inputs": [
    {"name": "master", "ontology": "mirror"},
    {"name": "containerApps", "ontology": "mirror"},
    {"name": "network", "ontology": "mirror"}
  ],
  "parameters": [],
  "verbs": [
    {
      "id": "deployedApps",
      "verb": "graph-match",
      "graph": "containerApps",
      "pattern": {"nodes": [{"var": "a", "label": "ContainerApp"}]}
    },
    {
      "id": "showApps",
      "verb": "nodes",
      "target": {
        "nodes": [
          {
            "var": "result",
            "label": "ContainerApp",
            "id": {"ref": "a"},
