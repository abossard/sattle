        "nodes": [{"var": "s", "label": "SystemComponent"}, {"var": "b", "label": "OperationSelector"}],
        "edges": [{"var": "binding", "label": "ExpectsOperation", "from": "s", "to": "b"}]
      }
    },
    {
      "id": "stepChecks",
      "verb": "project",
