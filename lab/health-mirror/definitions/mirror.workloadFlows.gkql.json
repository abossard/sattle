              "inferredState": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "severity"}, {"lit": 4}]},
                  {"lit": "Unhealthy"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "severity"}, {"lit": 3}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "severity"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
                  }
                ]
              },
              "evidenceKind": {
                "fn": "iff",
                "args": [
                  {"fn": ">", "args": [{"ref": "measured"}, {"lit": 0}]},
                  {"lit": "InferredFromSteps"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "rank"}, {"lit": 0}]},
