{
  "graph": "health",
  "ontology": "mirror",
  "description": "Combine measured signals and roll child health up through each dependency.",
  "history": 240,
  "inputs": [{"name": "structure", "ontology": "mirror"}, {"name": "signals", "ontology": "mirror"}],
  "parameters": [],
  "verbs": [
    {
      "id": "modelEntities",
      "verb": "graph-match",
      "graph": "structure",
      "pattern": {"nodes": [{"var": "e", "label": "ModelEntity"}]}
    },
    {"id": "noKnownSignal", "verb": "project", "columns": {"key": {"ref": "e.key"}, "rank": {"lit": 0}}},
    {
      "id": "evaluatedSignals",
      "verb": "graph-match",
      "graph": "signals",
      "pattern": {"nodes": [{"var": "s", "label": "EvaluatedSignal"}]}
    },
    {
      "id": "signalRanks",
      "verb": "project",
      "columns": {"key": {"ref": "s.entityKey"}, "rank": {"ref": "s.rank"}}
    },
    {"id": "ownStateInputs", "verb": "union"},
    {
      "id": "ownState",
      "verb": "summarize",
      "by": {"key": {"ref": "key"}},
      "aggregates": {"rank": {"fn": "max", "args": [{"ref": "rank"}]}}
    },
    {
      "id": "modelDependencies",
      "verb": "graph-match",
      "graph": "structure",
      "pattern": {
        "nodes": [{"var": "a", "label": "ModelEntity"}, {"var": "b", "label": "ModelEntity"}],
        "edges": [{"var": "edge", "label": "DependsOn", "from": "a", "to": "b"}]
      }
    },
    {
      "id": "keepDependency",
      "verb": "edges",
      "target": {
        "nodes": [
          {"var": "a", "label": "ModelEntity", "id": {"ref": "a"}},
          {"var": "b", "label": "ModelEntity", "id": {"ref": "b"}}
        ],
        "edges": [
          {
            "var": "edge",
            "label": "DependsOn",
            "from": "a",
            "to": "b",
            "props": {
              "key": {"ref": "edge.key"},
              "impact": {"ref": "edge.impact"},
              "configuration": {"ref": "edge.configuration"}
            }
          }
        ]
      }
    },
    {
      "id": "propagatingDependencies",
      "verb": "where",
      "condition": {"fn": "!=", "args": [{"ref": "b.impact"}, {"lit": "Suppressed"}]}
    },
    {
      "id": "childKeys",
      "verb": "project",
      "columns": {"parentKey": {"ref": "a.key"}, "childKey": {"ref": "b.key"}, "impact": {"ref": "b.impact"}}
    },
    {"id": "childrenAt1", "verb": "join", "kind": "inner", "on": [{"left": "childKey", "right": "key"}]},
    {
      "id": "impactAt1",
      "verb": "project",
      "columns": {
        "key": {"ref": "parentKey"},
        "rank": {
          "fn": "iff",
          "args": [
            {"fn": "==", "args": [{"ref": "impact"}, {"lit": "Limited"}]},
            {
              "fn": "iff",
              "args": [
                {"fn": "==", "args": [{"ref": "rank"}, {"lit": 3}]},
                {"lit": 2},
                {
                  "fn": "iff",
                  "args": [{"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]}, {"lit": 1}, {"ref": "rank"}]
                }
              ]
            },
            {"ref": "rank"}
          ]
        }
      }
    },
    {"id": "rollupAt1Inputs", "verb": "union"},
    {
      "id": "rollupAt1",
      "verb": "summarize",
      "by": {"key": {"ref": "key"}},
      "aggregates": {"rank": {"fn": "max", "args": [{"ref": "rank"}]}}
    },
    {"id": "childrenAt2", "verb": "join", "kind": "inner", "on": [{"left": "childKey", "right": "key"}]},
    {
      "id": "impactAt2",
      "verb": "project",
      "columns": {
        "key": {"ref": "parentKey"},
        "rank": {
          "fn": "iff",
          "args": [
            {"fn": "==", "args": [{"ref": "impact"}, {"lit": "Limited"}]},
            {
              "fn": "iff",
              "args": [
                {"fn": "==", "args": [{"ref": "rank"}, {"lit": 3}]},
                {"lit": 2},
                {
                  "fn": "iff",
                  "args": [{"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]}, {"lit": 1}, {"ref": "rank"}]
                }
              ]
            },
            {"ref": "rank"}
          ]
        }
      }
    },
    {"id": "rollupAt2Inputs", "verb": "union"},
    {
      "id": "rollupAt2",
      "verb": "summarize",
      "by": {"key": {"ref": "key"}},
      "aggregates": {"rank": {"fn": "max", "args": [{"ref": "rank"}]}}
    },
    {"id": "childrenAt3", "verb": "join", "kind": "inner", "on": [{"left": "childKey", "right": "key"}]},
    {
      "id": "impactAt3",
      "verb": "project",
      "columns": {
        "key": {"ref": "parentKey"},
        "rank": {
          "fn": "iff",
          "args": [
            {"fn": "==", "args": [{"ref": "impact"}, {"lit": "Limited"}]},
            {
              "fn": "iff",
              "args": [
                {"fn": "==", "args": [{"ref": "rank"}, {"lit": 3}]},
                {"lit": 2},
                {
                  "fn": "iff",
                  "args": [{"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]}, {"lit": 1}, {"ref": "rank"}]
                }
              ]
            },
            {"ref": "rank"}
          ]
        }
      }
    },
    {"id": "rollupAt3Inputs", "verb": "union"},
    {
      "id": "rollupAt3",
      "verb": "summarize",
      "by": {"key": {"ref": "key"}},
      "aggregates": {"rank": {"fn": "max", "args": [{"ref": "rank"}]}}
    },
    {
      "id": "ownStates",
      "verb": "project",
      "columns": {"localKey": {"ref": "key"}, "localRank": {"ref": "rank"}}
    },
    {"id": "combineStates", "verb": "join", "kind": "inner", "on": [{"left": "key", "right": "localKey"}]},
    {"id": "entityKeys", "verb": "project", "columns": {"e": {"ref": "e"}, "modelKey": {"ref": "e.key"}}},
    {"id": "joinEntity", "verb": "join", "kind": "inner", "on": [{"left": "modelKey", "right": "key"}]},
    {
      "id": "entityHealth",
      "verb": "nodes",
      "target": {
        "nodes": [
          {
            "var": "result",
            "label": "ModelEntity",
            "id": {"ref": "e"},
            "props": {
              "key": {"ref": "e.key"},
              "name": {"ref": "e.name"},
              "configuration": {"ref": "e.configuration"},
              "impact": {"ref": "e.impact"},
              "state": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "rank"}, {"lit": 3}]},
                  {"lit": "Unhealthy"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "rank"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
                  }
                ]
              },
              "ownState": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "localRank"}, {"lit": 3}]},
                  {"lit": "Unhealthy"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "localRank"}, {"lit": 2}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "localRank"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "wires": [
    {"from": "modelEntities", "to": "noKnownSignal"},
    {"from": "evaluatedSignals", "to": "signalRanks"},
    {"from": "noKnownSignal", "to": "ownStateInputs"},
    {"from": "signalRanks", "to": "ownStateInputs"},
    {"from": "ownStateInputs", "to": "ownState"},
    {"from": "modelDependencies", "to": "keepDependency"},
    {"from": "modelDependencies", "to": "propagatingDependencies"},
    {"from": "propagatingDependencies", "to": "childKeys"},
    {"from": "childKeys", "to": "childrenAt1", "port": "left"},
    {"from": "ownState", "to": "childrenAt1", "port": "right"},
    {"from": "childrenAt1", "to": "impactAt1"},
    {"from": "ownState", "to": "rollupAt1Inputs"},
    {"from": "impactAt1", "to": "rollupAt1Inputs"},
    {"from": "rollupAt1Inputs", "to": "rollupAt1"},
    {"from": "childKeys", "to": "childrenAt2", "port": "left"},
    {"from": "rollupAt1", "to": "childrenAt2", "port": "right"},
    {"from": "childrenAt2", "to": "impactAt2"},
    {"from": "ownState", "to": "rollupAt2Inputs"},
    {"from": "impactAt2", "to": "rollupAt2Inputs"},
    {"from": "rollupAt2Inputs", "to": "rollupAt2"},
    {"from": "childKeys", "to": "childrenAt3", "port": "left"},
    {"from": "rollupAt2", "to": "childrenAt3", "port": "right"},
    {"from": "childrenAt3", "to": "impactAt3"},
    {"from": "ownState", "to": "rollupAt3Inputs"},
    {"from": "impactAt3", "to": "rollupAt3Inputs"},
    {"from": "rollupAt3Inputs", "to": "rollupAt3"},
    {"from": "ownState", "to": "ownStates"},
    {"from": "rollupAt3", "to": "combineStates", "port": "left"},
    {"from": "ownStates", "to": "combineStates", "port": "right"},
    {"from": "modelEntities", "to": "entityKeys"},
    {"from": "entityKeys", "to": "joinEntity", "port": "left"},
    {"from": "combineStates", "to": "joinEntity", "port": "right"},
    {"from": "joinEntity", "to": "entityHealth"}
  ]
}
