{
  "graph": "containerApps",
  "ontology": "mirror",
  "description": "Discover Azure Container Apps and classify their deployment state and names.",
  "history": 240,
  "inputs": [{"name": "master", "ontology": "mirror"}],
  "parameters": [],
  "verbs": [
    {
      "id": "resources",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {"nodes": [{"var": "r", "label": "ArmResource"}]}
    },
    {
      "id": "containerAppRows",
      "verb": "where",
