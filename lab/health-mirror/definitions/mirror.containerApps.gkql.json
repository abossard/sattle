    },
    {"id": "attachMembership", "verb": "join", "kind": "inner", "on": [{"left": "appKey", "right": "key"}]},
    {
      "id": "appMembership",
      "verb": "project",
      "columns": {
        "r": {"ref": "r"},
        "appKey": {"ref": "appKey"},
        "appRank": {"ref": "appRank"},
        "assigned": {"ref": "rank"}
      }
    },
    {
      "id": "observedAppsForRules",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {"nodes": [{"var": "r", "label": "ArmResource"}]}
    },
    {
      "id": "scopedContainerNames",
      "verb": "where",
      "condition": {"fn": "==", "args": [{"ref": "r.resourceType"}, {"lit": "microsoft.app/containerapps"}]}
    },
    {
      "id": "deployedNames",
      "verb": "project",
      "columns": {
        "app": {"ref": "r"},
        "appKey": {"ref": "r.armKey"},
        "scope": {"ref": "r.groupId"},
        "appName": {"ref": "r.name"}
      }
    },
    {
      "id": "curatedNames",
      "verb": "graph-match",
      "graph": "master",
      "pattern": {"nodes": [{"var": "n", "label": "NameRule"}]}
    },
    {
      "id": "rulesByScope",
      "verb": "project",
      "columns": {"rule": {"ref": "n"}, "ruleScope": {"ref": "n.scopeId"}}
    },
    {"id": "ruleCandidates", "verb": "join", "kind": "inner", "on": [{"left": "scope", "right": "ruleScope"}]},
    {
      "id": "matchingNames",
      "verb": "where",
      "condition": {
        "fn": "iff",
        "args": [
          {"fn": "==", "args": [{"ref": "rule.matchKind"}, {"lit": "prefix"}]},
          {"fn": "startswith", "args": [{"ref": "appName"}, {"ref": "rule.pattern"}]},
          {
            "fn": "iff",
            "args": [
              {"fn": "==", "args": [{"ref": "rule.matchKind"}, {"lit": "suffix"}]},
              {"fn": "endswith", "args": [{"ref": "appName"}, {"ref": "rule.pattern"}]},
              {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "rule.matchKind"}, {"lit": "contains"}]},
                  {"fn": "contains", "args": [{"ref": "appName"}, {"ref": "rule.pattern"}]},
                  {"lit": false}
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "matchedRules",
      "verb": "nodes",
