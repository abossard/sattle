            "id": {"ref": "rule"},
            "props": {
              "key": {"ref": "rule.key"},
              "name": {"ref": "rule.name"},
              "scopeId": {"ref": "rule.scopeId"},
              "matchKind": {"ref": "rule.matchKind"},
              "pattern": {"ref": "rule.pattern"},
              "className": {"ref": "rule.className"},
              "evidence": {"ref": "rule.evidence"}
            }
          }
        ]
      }
    },
    {
      "id": "matchingRule",
      "verb": "edges",
      "target": {
        "nodes": [
          {"var": "a", "label": "ContainerApp", "id": {"ref": "app"}},
