    },
    {
      "id": "deploymentState",
      "verb": "extend",
      "columns": {
        "rank": {
          "fn": "iff",
          "args": [
            {
              "fn": "or",
              "args": [
                {
                  "fn": "or",
                  "args": [
                    {
                      "fn": "==",
                      "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "failed"}]
                    },
                    {
                      "fn": "==",
                      "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "canceled"}]
                    },
                    {
                      "fn": "==",
                      "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "cancelled"}]
                    }
                  ]
                },
                {
                  "fn": "or",
                  "args": [
                    {
                      "fn": "==",
                      "args": [{"fn": "lower", "args": [{"ref": "r.runningStatus"}]}, {"lit": "failed"}]
                    },
                    {
                      "fn": "==",
                      "args": [{"fn": "lower", "args": [{"ref": "r.runningStatus"}]}, {"lit": "stopped"}]
                    }
                  ]
                }
              ]
            },
            {"lit": 3},
            {
              "fn": "iff",
              "args": [
                {
                  "fn": "or",
                  "args": [
                    {
                      "fn": "or",
                      "args": [
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "updating"}]
                        },
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "creating"}]
                        },
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "deleting"}]
                        }
                      ]
                    },
                    {
                      "fn": "or",
                      "args": [
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.runningStatus"}]}, {"lit": "progressing"}]
                        },
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.runningStatus"}]}, {"lit": "degraded"}]
                        }
                      ]
                    }
                  ]
                },
                {"lit": 2},
                {
                  "fn": "iff",
                  "args": [
                    {
                      "fn": "and",
                      "args": [
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.provisioningState"}]}, {"lit": "succeeded"}]
                        },
                        {
                          "fn": "==",
                          "args": [{"fn": "lower", "args": [{"ref": "r.runningStatus"}]}, {"lit": "running"}]
                        }
                      ]
                    },
                    {"lit": 1},
                    {"lit": 0}
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "appKeys",
      "verb": "project",
      "columns": {"appKey": {"ref": "r.armKey"}, "r": {"ref": "r"}, "appRank": {"ref": "rank"}}
    },
    {"id": "everyApp", "verb": "project", "columns": {"key": {"ref": "r.armKey"}, "rank": {"lit": 0}}},
    {
      "id": "declaredFlowPath",
      "verb": "graph-match",
