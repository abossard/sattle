        "edges": [
          {"var": "step", "label": "DeclaresStep", "from": "f", "to": "s"},
          {"var": "deployment", "label": "RunsOnResource", "from": "s", "to": "a"}
        ]
      }
    },
    {"id": "flowMembership", "verb": "project", "columns": {"key": {"ref": "a.armKey"}, "rank": {"lit": 1}}},
    {"id": "hasDeclaredFlowInputs", "verb": "union"},
    {
      "id": "hasDeclaredFlow",
      "verb": "summarize",
      "by": {"key": {"ref": "key"}},
