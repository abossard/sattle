    },
    {"id": "everyEnvironment", "verb": "project", "columns": {"key": {"ref": "envKey"}, "rank": {"lit": 0}}},
    {"id": "hostedAppRanks", "verb": "project", "columns": {"key": {"ref": "envKey"}, "rank": {"ref": "rank"}}},
