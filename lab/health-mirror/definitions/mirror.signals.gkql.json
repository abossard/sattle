                                {"fn": "coalesce", "args": [{"ref": "d.degradedAt"}, {"lit": 0.0}]}
                              ]
                            },
                            {
                              "fn": "iff",
                              "args": [
                                {
                                  "fn": "==",
                                  "args": [{"ref": "d.degradedOperator"}, {"lit": "GreaterThanOrEqual"}]
