                                        {"fn": "coalesce", "args": [{"ref": "d.unhealthyAt"}, {"lit": 0.0}]}
                                      ]
                                    },
                                    {
                                      "fn": "iff",
                                      "args": [
                                        {"fn": "==", "args": [{"ref": "d.unhealthyOperator"}, {"lit": "Equal"}]},
