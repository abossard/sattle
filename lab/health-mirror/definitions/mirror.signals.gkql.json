                                                {
                                                  "fn": "coalesce",
                                                  "args": [{"ref": "d.unhealthyAt"}, {"lit": 0.0}]
                                                }
                                              ]
                                            },
                                            {"lit": false}
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {"lit": 3},
                    {
                      "fn": "iff",
                      "args": [
