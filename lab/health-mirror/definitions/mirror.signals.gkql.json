                                                  "args": [
                                                    {
                                                      "fn": "coalesce",
                                                      "args": [{"ref": "o.value"}, {"lit": 0.0}]
                                                    },
                                                    {
                                                      "fn": "coalesce",
                                                      "args": [{"ref": "d.degradedAt"}, {"lit": 0.0}]
                                                    }
                                                  ]
                                                },
                                                {"lit": false}
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {"lit": 2},
                        {"lit": 1}
                      ]
                    }
                  ]
                }
              ]
            },
            {"lit": 0}
          ]
        }
      }
    },
    {
      "id": "evaluatedBinding",
      "verb": "nodes",
      "target": {
        "nodes": [
          {
            "var": "result",
            "label": "EvaluatedSignal",
            "id": {"ref": "b"},
            "props": {
              "key": {"ref": "b.key"},
              "name": {"ref": "b.name"},
              "configuration": {"ref": "b.configuration"},
              "entityKey": {"ref": "b.entityKey"},
              "definitionKey": {"ref": "b.definitionKey"},
              "status": {"ref": "o.status"},
              "checkpoint": {"ref": "o.checkpoint"},
              "value": {"ref": "o.value"},
              "availabilityState": {"ref": "o.availabilityState"},
              "rank": {"ref": "rank"},
              "state": {
                "fn": "iff",
                "args": [
                  {"fn": "==", "args": [{"ref": "rank"}, {"lit": 3}]},
                  {"lit": "Unhealthy"},
                  {
                    "fn": "iff",
                    "args": [
                      {"fn": "==", "args": [{"ref": "rank"}, {"lit": 2}]},
                      {"lit": "Degraded"},
                      {
                        "fn": "iff",
                        "args": [
                          {"fn": "==", "args": [{"ref": "rank"}, {"lit": 1}]},
                          {"lit": "Healthy"},
                          {"lit": "Unknown"}
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "wires": [{"from": "boundReadings", "to": "applyRules"}, {"from": "applyRules", "to": "evaluatedBinding"}]
}
