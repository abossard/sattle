                                {
                                  "fn": ">=",
                                  "args": [
                                    {"fn": "coalesce", "args": [{"ref": "o.value"}, {"lit": 0.0}]},
                                    {"fn": "coalesce", "args": [{"ref": "d.degradedAt"}, {"lit": 0.0}]}
                                  ]
                                },
                                {
                                  "fn": "iff",
                                  "args": [
                                    {"fn": "==", "args": [{"ref": "d.degradedOperator"}, {"lit": "LessThan"}]},
                                    {
                                      "fn": "<",
                                      "args": [
                                        {"fn": "coalesce", "args": [{"ref": "o.value"}, {"lit": 0.0}]},
                                        {"fn": "coalesce", "args": [{"ref": "d.degradedAt"}, {"lit": 0.0}]}
                                      ]
                                    },
                                    {
                                      "fn": "iff",
                                      "args": [
                                        {
                                          "fn": "==",
                                          "args": [{"ref": "d.degradedOperator"}, {"lit": "LessThanOrEqual"}]
