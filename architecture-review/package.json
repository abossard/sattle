{
  "name": "sattle-architecture-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-review.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run generate && vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "build": "npm run generate && npm run typecheck && vite build",
    "check": "npm test && npm run generate -- --check && npm run typecheck && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist --project-name=sattle-architecture-review"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "^4.45.1"
  }
}
