/// Limit L9 of research note 05.
module research.limit9 @ 1.0.0;

import sattle.infra @ 1.0.0 sha256:34a45e53639c852d432b9046b48991f90d7d0fc70b33654d167cec443cabdeec as infra;
import acme.ops     @ 1.0.0 sha256:4aaa8303eb10fae2a3b2c0d8ee083ae125d87e250094badad54d7a1384c75cdd as ops;
import acme.svc     @ 1.0.0 sha256:91ac722e4f25a0703c811849412c49d5fdea1adc1d9f075c7741ce3fb8371404 as svc;

entity Mark { markKey: Text; markN?: Integer; markFlows?: Integer telemetry delta sum every 60s; markBytes?: Integer telemetry cumulative max every 60s; }
identity mark for Mark version "1" { key: Text by exact; }

/// L9 an arithmetic column inside a fixpoint body (hop counter): the finite-domain condition F5.
projection counter view forward output research.limit9 {
  in master: graph ops;
  retain 1;
  let edges = match master (c: ops.Capability)-[:ops.PartOf]->(p: ops.Capability) |> select { a: entityId(c), b: entityId(p), h: 1 };
  let step = edges |> select { a2: a, b2: b };
  let closure = fixpoint edges via join closure, step on b == a2 |> select { a: a, b: b2, h: h + 1 } max 8;
  emit entity Mark from closure identity mark(key: concat(a, b)) set { markKey: a, markN: h };
}

